+#ifdef __amigaos__
+/*
+** Decoded effect cache. Decoding a compressed effect costs ~600 ns per sample on the 68060 and the
+** battle plays the same few effects over and over, so every effect is decoded once and then played
+** from memory as uncompressed data. The key holds the pointer, both sizes and a checksum of the start
+** of the data (a freed and reused address must not hit an old entry). Music streams do not use this.
+*/
+struct DecodedSample
+{
+    const void* Sample;
+    int CompSize;
+    int UncompSize;
+    unsigned Sum;
+    unsigned char* Pcm;
+    int Bytes;
+};
+static DecodedSample DecodedCache[96];
+static int DecodedCount = 0;
+static int DecodedTotal = 0;
+
+static unsigned Decoded_Sum(const void* sample)
+{
+    const unsigned char* p = static_cast<const unsigned char*>(sample) + sizeof(AUDHeaderType);
+    unsigned sum = 0;
+    for (int i = 0; i < 64; ++i) {
+        sum = sum * 31 + p[i];
+    }
+    return sum;
+}
+
+static void Use_Decoded_Sample(SampleTrackerType* st, const void* sample, int comp_size, int uncomp_size)
+{
+    if (st->Compression == SCOMP_NONE || comp_size < 64 || comp_size > 262144 || uncomp_size <= 0 || uncomp_size > 1048576) {
+        return;
+    }
+    const unsigned sum = Decoded_Sum(sample);
+    for (int i = 0; i < DecodedCount; ++i) {
+        const DecodedSample& d = DecodedCache[i];
+        if (d.Sample == sample && d.CompSize == comp_size && d.UncompSize == uncomp_size && d.Sum == sum) {
+            st->Compression = SCOMP_NONE;
+            st->Source = d.Pcm;
+            st->Remainder = d.Bytes;
+            return;
+        }
+    }
+    if (DecodedCount >= 96 || DecodedTotal + uncomp_size > (6 << 20)) {
+        return; // cache full: decode while playing, as before
+    }
+    unsigned char* pcm = static_cast<unsigned char*>(malloc(uncomp_size + BUFFER_CHUNK_SIZE));
+    if (!pcm) {
+        return;
+    }
+    void* src = st->Source;
+    int rem = st->Remainder;
+    void* qb = nullptr;
+    int qs = 0;
+    int total = 0;
+    for (;;) {
+        int n = Sample_Copy(st, &src, &rem, &qb, &qs, pcm + total, BUFFER_CHUNK_SIZE, st->Compression, nullptr, nullptr);
+        if (n > 0) {
+            total += n;
+        }
+        if (n != BUFFER_CHUNK_SIZE || total > uncomp_size) {
+            break;
+        }
+    }
+    if (total <= 0) {
+        free(pcm);
+        return;
+    }
+    DecodedSample& d = DecodedCache[DecodedCount++];
+    d.Sample = sample;
+    d.CompSize = comp_size;
+    d.UncompSize = uncomp_size;
+    d.Sum = sum;
+    d.Pcm = pcm;
+    d.Bytes = total;
+    DecodedTotal += uncomp_size;
+    st->Compression = SCOMP_NONE;
+    st->Source = pcm;
+    st->Remainder = total;
+}
+#endif
+
