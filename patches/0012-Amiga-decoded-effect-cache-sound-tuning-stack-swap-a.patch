new file mode 100644
index 0000000..d71d026
--- /dev/null
+++ b/common/amiga_stack.cpp
@@ -0,0 +1,12 @@
+// Stack size and version tag for the Amiga build (bebbo gcc / libnix).
+// __stack alone does not enlarge the stack: libnix swaps stacks only when swapstack.o (__stkinit) is
+// linked, so it is referenced here. Without it a start from the icon runs with the icon's stack.
+extern "C" {
+unsigned long __stack = 512 * 1024;
+extern void __stkinit(void);
+void (*const amiga_stack_swap)(void) = __stkinit;
+}
+
+#define CNC_PORT_VERSION "0.1"
+// Shell `Version` command; the release number is bumped for every build given to users.
+extern "C" const char amiga_version_tag[] = "$VER: CnC-TD " CNC_PORT_VERSION " (22.11.2026)";
