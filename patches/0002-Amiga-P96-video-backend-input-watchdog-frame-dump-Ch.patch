+            UWORD code = msg->Code;
+            WORD mx = msg->MouseX;
+            WORD my = msg->MouseY;
+            ReplyMsg((struct Message*)msg);
+            {
+                FILE* ef = std::fopen("RAM:cnc-log.txt", "a");
+                if (ef) {
+                    std::fprintf(ef, "event class %lx code %x poll %u\n", (unsigned long)cls, (unsigned)code, KbdPolls);
+                    std::fclose(ef);
+                }
+            }
+
+            switch (cls) {
+            case IDCMP_RAWKEY: {
+                bool release = (code & IECODE_UP_PREFIX) != 0;
+                if ((code & 0x7F) == 0x59 && !release) {
+                    Amiga_Request_Frame_Dump(); // F10: frame dump to RAM:cnc-frame.bin
+                }
+                unsigned char vk = RawToVK[code & 0x7F];
+                if (vk) {
+                    Put_Key_Message(vk, release);
+                }
+            } break;
+            case IDCMP_MOUSEMOVE:
+                Amiga_Mouse_Set(mx, my);
+                break;
+            case IDCMP_MOUSEBUTTONS: {
+                Amiga_Mouse_Set(mx, my);
+                int x, y;
+                Get_Video_Mouse(x, y);
+                unsigned short key = 0;
+                bool release = false;
+                switch (code) {
+                case SELECTDOWN:
+                    key = VK_LBUTTON;
+                    break;
+                case SELECTUP:
+                    key = VK_LBUTTON;
+                    release = true;
+                    break;
+                case MENUDOWN:
+                    key = VK_RBUTTON;
+                    break;
+                case MENUUP:
+                    key = VK_RBUTTON;
+                    release = true;
+                    break;
+                case MIDDLEDOWN:
+                    key = VK_MBUTTON;
+                    break;
+                case MIDDLEUP:
+                    key = VK_MBUTTON;
+                    release = true;
+                    break;
+                }
+                if (key) {
+                    Put_Mouse_Message(key, x, y, release);
+                }
+            } break;
+            case IDCMP_ACTIVEWINDOW:
+                Focus_Restore();
+                break;
+            case IDCMP_INACTIVEWINDOW:
+                Focus_Loss();
+                break;
+            }
