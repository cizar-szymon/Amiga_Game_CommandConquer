diff --git a/common/amiga_watchdog.cpp b/common/amiga_watchdog.cpp
new file mode 100644
index 0000000..9ae4893
--- /dev/null
+++ b/common/amiga_watchdog.cpp
@@ -0,0 +1,92 @@
+// Hang guard for the Amiga port. A helper process watches a heartbeat counter
+// that the main task bumps on every frame and input poll. If the counter stops
+// for ~4 s the guard writes the main task's saved PC and top of stack to
+// RAM:cnc-hang.txt (map the words to functions with nm + the base address from
+// RAM:cnc-log.txt "main=").
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exec/types.h>
+#include <exec/tasks.h>
+#include <dos/dos.h>
+#include <dos/dostags.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+
+volatile unsigned Amiga_Heartbeat = 0;
+
+static struct Task* MainTask = nullptr;
+static volatile int StopFlag = 0;
+static volatile int Finished = 0;
+
+static void Write_Hang(unsigned beats)
+{
+    FILE* f = std::fopen("RAM:cnc-hang.txt", "a");
+    if (!f) {
+        return;
+    }
+    Forbid();
+    unsigned long* sp = (unsigned long*)MainTask->tc_SPReg;
+    unsigned char* b = (unsigned char*)sp;
+    unsigned long pc = ((unsigned long)b[62] << 24) | ((unsigned long)b[63] << 16) | ((unsigned long)b[64] << 8) | b[65];
+    unsigned long words[48];
+    for (int i = 0; i < 48; i++) {
+        words[i] = sp[i];
+    }
+    Permit();
+    std::fprintf(f, "HANG heartbeat %u stuck, saved PC %08lx\n", beats, pc);
+    std::fprintf(f, "regs/stack words:");
+    for (int i = 0; i < 48; i++) {
+        if ((i % 8) == 0) {
+            std::fprintf(f, "\n ");
+        }
+        std::fprintf(f, " %08lx", words[i]);
+    }
+    std::fprintf(f, "\n");
+    std::fclose(f);
+}
+
+static void Watchdog_Main()
+{
+    unsigned last = Amiga_Heartbeat;
+    int stuck = 0;
+    bool reported = false;
+    while (!StopFlag) {
+        Delay(100); // 2 s
+        unsigned now = Amiga_Heartbeat;
+        if (now == last) {
+            if (++stuck >= 2 && !reported) {
+                Write_Hang(now);
+                reported = true;
+            }
+        } else {
+            stuck = 0;
+            reported = false;
+            last = now;
+        }
+    }
+    Finished = 1;
+}
+
+static void Stop_Watchdog()
+{
+    StopFlag = 1;
+    for (int i = 0; i < 300 && !Finished; i++) {
+        Delay(1);
+    }
+}
+
+void Amiga_Start_Watchdog()
+{
+    MainTask = FindTask(NULL);
+    std::atexit(Stop_Watchdog);
+    CreateNewProcTags(NP_Entry,
+                      (ULONG)Watchdog_Main,
+                      NP_Name,
+                      (ULONG) "cnc-watchdog",
+                      NP_Priority,
+                      5UL,
+                      NP_StackSize,
+                      16384UL,
+                      TAG_DONE);
+}
diff --git a/common/video_amiga.cpp b/common/video_amiga.cpp
new file mode 100644
index 0000000..8e91c70
--- /dev/null
+++ b/common/video_amiga.cpp
@@ -0,0 +1,554 @@
+// AmigaOS video backend for Vanilla Conquer (Warp / Picasso96, 8-bit CLUT screen).
+//
+// Surfaces are plain 8-bit buffers in Fast RAM (16-byte aligned, pitch = width).
+// The visible surface is presented once per frame from Video_Render_Frame()
+// (called by Frame_Limiter): the game palette is loaded with LoadRGB32 and the
+// indexed pixels go to the card with one WritePixelArray(RECTFMT_LUT8).
+// F3 first version: whole frame every time, software cursor. F4 replaces this
+// with dirty rectangles, MOVE16 into locked VRAM and a hardware cursor.
+#include "gbuffer.h"
+#include "palette.h"
+#include "video.h"
+#include "wwmouse.h"
+#include "rect.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include <exec/types.h>
+#include <exec/memory.h>
+#include <intuition/intuition.h>
+#include <intuition/screens.h>
+#include <graphics/gfx.h>
+#include <graphics/modeid.h>
+#include <cybergraphx/cybergraphics.h>
+#include <proto/exec.h>
+#include <proto/intuition.h>
+#include <proto/graphics.h>
+#include <proto/cybergraphics.h>
+
+struct Library* CyberGfxBase = nullptr;
+extern struct IntuitionBase* IntuitionBase;
+extern struct GfxBase* GfxBase;
+
+static struct Screen* AmigaScreen = nullptr;
+static struct Window* AmigaWindow = nullptr;
+static UWORD* BlankPointer = nullptr;
+static int ScreenW = 0;
+static int ScreenH = 0;
+static ULONG PaletteTable[2 + 256 * 3];
+static unsigned char RawPalette[768];
+
+static int MouseX = 0;
+static int MouseY = 0;
+
+static struct
+{
+    unsigned char* Data;
+    int W, H, HotX, HotY;
+} GameCursor = {nullptr, 0, 0, 0, 0};
+
+struct Window* Amiga_Get_Window()
+{
+    return AmigaWindow;
+}
+
+void Amiga_Mouse_Set(int x, int y)
+{
+    if (x < 0)
+        x = 0;
+    if (y < 0)
+        y = 0;
+    if (ScreenW && x >= ScreenW)
+        x = ScreenW - 1;
+    if (ScreenH && y >= ScreenH)
+        y = ScreenH - 1;
+    MouseX = x;
+    MouseY = y;
+}
+
+class SurfaceMonitorClassAmiga : public SurfaceMonitorClass
+{
+public:
+    virtual void Restore_Surfaces()
+    {
+    }
+    virtual void Set_Surface_Focus(bool in_focus)
+    {
+    }
+    virtual void Release()
+    {
+    }
+};
+
+SurfaceMonitorClassAmiga AllSurfacesAmiga;
+SurfaceMonitorClass& AllSurfaces = AllSurfacesAmiga;
+
+SurfaceMonitorClass::SurfaceMonitorClass()
+{
+    SurfacesRestored = false;
+}
+
+bool Set_Video_Mode(int w, int h, int bits_per_pixel)
+{
+    if (AmigaScreen) {
+        return true;
+    }
+
+    CyberGfxBase = OpenLibrary((CONST_STRPTR) "cybergraphics.library", 0);
+    ULONG id = INVALID_ID;
+    if (CyberGfxBase) {
+        id = BestModeID(BIDTAG_NominalWidth, w, BIDTAG_NominalHeight, h, BIDTAG_Depth, 8, TAG_DONE);
+    }
+    if (id == INVALID_ID) {
+        std::fprintf(stderr, "No %dx%d 8-bit RTG mode\n", w, h);
+        return false;
+    }
+
+    AmigaScreen = OpenScreenTags(NULL,
+                                 SA_Width,
+                                 (ULONG)w,
+                                 SA_Height,
+                                 (ULONG)h,
+                                 SA_Depth,
+                                 8UL,
+                                 SA_DisplayID,
+                                 id,
+                                 SA_Quiet,
+                                 (ULONG)TRUE,
+                                 SA_ShowTitle,
+                                 (ULONG)FALSE,
+                                 TAG_DONE);
+    if (!AmigaScreen) {
+        return false;
+    }
+
+    AmigaWindow = OpenWindowTags(NULL,
+                                 WA_CustomScreen,
+                                 (ULONG)AmigaScreen,
+                                 WA_Left,
+                                 0UL,
+                                 WA_Top,
+                                 0UL,
+                                 WA_Width,
+                                 (ULONG)AmigaScreen->Width,
+                                 WA_Height,
+                                 (ULONG)AmigaScreen->Height,
+                                 WA_Borderless,
+                                 (ULONG)TRUE,
+                                 WA_Backdrop,
+                                 (ULONG)TRUE,
+                                 WA_Activate,
+                                 (ULONG)TRUE,
+                                 WA_RMBTrap,
+                                 (ULONG)TRUE,
+                                 WA_ReportMouse,
+                                 (ULONG)TRUE,
+                                 WA_IDCMP,
+                                 (ULONG)(IDCMP_RAWKEY | IDCMP_MOUSEMOVE | IDCMP_MOUSEBUTTONS | IDCMP_ACTIVEWINDOW
+                                         | IDCMP_INACTIVEWINDOW),
+                                 TAG_DONE);
+    if (!AmigaWindow) {
+        CloseScreen(AmigaScreen);
+        AmigaScreen = nullptr;
+        return false;
+    }
+
+    // Invisible system pointer; the game draws its own cursor.
+    BlankPointer = (UWORD*)AllocMem(12, MEMF_CHIP | MEMF_CLEAR);
+    if (BlankPointer) {
+        SetPointer(AmigaWindow, BlankPointer, 1, 1, 0, 0);
+    }
+
+    ScreenW = w;
+    ScreenH = h;
+    MouseX = w / 2;
+    MouseY = h / 2;
+    return true;
+}
+
+bool Is_Video_Fullscreen()
+{
+    return true;
+}
+
+void Reset_Video_Mode(void)
+{
+    if (AmigaWindow) {
+        ClearPointer(AmigaWindow);
+        CloseWindow(AmigaWindow);
+        AmigaWindow = nullptr;
+    }
+    if (BlankPointer) {
+        FreeMem(BlankPointer, 12);
+        BlankPointer = nullptr;
+    }
+    if (AmigaScreen) {
+        CloseScreen(AmigaScreen);
+        AmigaScreen = nullptr;
+    }
+    if (CyberGfxBase) {
+        CloseLibrary(CyberGfxBase);
+        CyberGfxBase = nullptr;
+    }
+}
+
+unsigned int Get_Free_Video_Memory(void)
+{
+    return 1000000000;
+}
+
+unsigned Get_Video_Hardware_Capabilities(void)
+{
+    return 0;
+}
+
+void Wait_Vert_Blank(void)
+{
+}
+
+void Wait_Blit(void)
+{
+}
+
+void Get_Video_Scale(float& x, float& y)
+{
+    x = 1.0f;
+    y = 1.0f;
+}
+
+void Set_Video_Cursor_Clip(bool clipped)
+{
+}
+
+void Toggle_Video_Fullscreen()
+{
+}
+
+void Move_Video_Mouse(float xrel, float yrel)
+{
+    Amiga_Mouse_Set(MouseX + (int)xrel, MouseY + (int)yrel);
+}
+
+void Get_Video_Mouse(int& x, int& y)
+{
+    x = MouseX;
+    y = MouseY;
+}
+
+void Set_Video_Cursor(void* cursor, int w, int h, int hotx, int hoty)
+{
+    if (GameCursor.Data) {
+        std::free(GameCursor.Data);
+        GameCursor.Data = nullptr;
+    }
+    if (cursor && w > 0 && h > 0) {
+        GameCursor.Data = (unsigned char*)std::malloc((size_t)w * h);
+        if (GameCursor.Data) {
+            std::memcpy(GameCursor.Data, cursor, (size_t)w * h);
+            GameCursor.W = w;
+            GameCursor.H = h;
+            GameCursor.HotX = hotx;
+            GameCursor.HotY = hoty;
+        }
+    }
+}
+
+void Set_DD_Palette(void* palette)
+{
+    const unsigned char* c = (const unsigned char*)palette;
+    std::memcpy(RawPalette, c, 768);
+    PaletteTable[0] = (256UL << 16) | 0;
+    for (int i = 0; i < 256; i++) {
+        for (int k = 0; k < 3; k++) {
+            unsigned v = c[i * 3 + k] & 63;
+            unsigned v8 = (v << 2) | (v >> 4);
+            PaletteTable[1 + i * 3 + k] = (ULONG)v8 * 0x01010101UL;
+        }
+    }
+    PaletteTable[1 + 256 * 3] = 0;
+    if (AmigaScreen) {
+        LoadRGB32(&AmigaScreen->ViewPort, PaletteTable);
+    }
+}
+
+/*
+** Surfaces: 8-bit buffers in Fast RAM, 16-byte aligned.
+*/
+class VideoSurfaceAmiga;
+static VideoSurfaceAmiga* frontSurface = nullptr;
+
+class VideoSurfaceAmiga : public VideoSurface
+{
+public:
+    VideoSurfaceAmiga(int w, int h, GBC_Enum flags)
+        : Width(w)
+        , Height(h)
+        , Flags(flags)
+        , Raw(nullptr)
+        , Pixels(nullptr)
+        , Present(nullptr)
+    {
+        Raw = (unsigned char*)AllocVec((ULONG)w * h + 16, MEMF_ANY | MEMF_CLEAR);
+        if (Raw) {
+            Pixels = (unsigned char*)(((unsigned long)Raw + 15) & ~15UL);
+        }
+        if (flags & GBC_VISIBLE) {
+            PresentRaw = (unsigned char*)AllocVec((ULONG)w * h + 16, MEMF_ANY | MEMF_CLEAR);
+            if (PresentRaw) {
+                Present = (unsigned char*)(((unsigned long)PresentRaw + 15) & ~15UL);
+            }
+            frontSurface = this;
+        }
+    }
+
+    virtual ~VideoSurfaceAmiga()
+    {
+        if (frontSurface == this) {
+            frontSurface = nullptr;
+        }
+        if (Raw) {
+            FreeVec(Raw);
+        }
+        if (Flags & GBC_VISIBLE) {
+            if (PresentRaw) {
+                FreeVec(PresentRaw);
+            }
+        }
+    }
+
+    virtual void* GetData() const
+    {
+        return Pixels;
+    }
+    virtual int GetPitch() const
+    {
+        return Width;
+    }
+    virtual bool IsAllocated() const
+    {
+        return false;
+    }
+    virtual void AddAttachedSurface(VideoSurface* surface)
+    {
+    }
+    virtual bool IsReadyToBlit()
+    {
+        return true;
+    }
+    virtual bool LockWait()
+    {
+        return Pixels != nullptr;
+    }
+    virtual bool Unlock()
+    {
+        return true;
+    }
+
+    virtual void Blt(const Rect& destRect, VideoSurface* src, const Rect& srcRect, bool mask)
+    {
+        VideoSurfaceAmiga* s = (VideoSurfaceAmiga*)src;
+        if (!Pixels || !s->Pixels) {
+            return;
+        }
+        int sx = srcRect.X, sy = srcRect.Y, w = srcRect.Width, h = srcRect.Height;
+        int dx = destRect.X, dy = destRect.Y;
+        // Clip against the source and destination surfaces.
+        if (sx < 0) {
+            dx -= sx;
+            w += sx;
+            sx = 0;
+        }
+        if (sy < 0) {
+            dy -= sy;
+            h += sy;
+            sy = 0;
+        }
+        if (dx < 0) {
+            sx -= dx;
+            w += dx;
+            dx = 0;
+        }
+        if (dy < 0) {
+            sy -= dy;
+            h += dy;
+            dy = 0;
+        }
+        if (sx + w > s->Width)
+            w = s->Width - sx;
+        if (sy + h > s->Height)
+            h = s->Height - sy;
+        if (dx + w > Width)
+            w = Width - dx;
+        if (dy + h > Height)
+            h = Height - dy;
+        if (w <= 0 || h <= 0) {
+            return;
+        }
+        for (int y = 0; y < h; y++) {
+            const unsigned char* sp = s->Pixels + (sy + y) * s->Width + sx;
+            unsigned char* dp = Pixels + (dy + y) * Width + dx;
+            if (mask) {
+                for (int x = 0; x < w; x++) {
+                    if (sp[x] != 0) {
+                        dp[x] = sp[x];
+                    }
+                }
+            } else {
+                std::memmove(dp, sp, (size_t)w);
+            }
+        }
+    }
+
+    virtual void FillRect(const Rect& rect, unsigned char color)
+    {
+        if (!Pixels) {
+            return;
+        }
+        int x0 = rect.X, y0 = rect.Y, x1 = rect.X + rect.Width + 1, y1 = rect.Y + rect.Height + 1;
+        if (x0 < 0)
+            x0 = 0;
+        if (y0 < 0)
+            y0 = 0;
+        if (x1 > Width)
+            x1 = Width;
+        if (y1 > Height)
+            y1 = Height;
+        for (int y = y0; y < y1; y++) {
+            if (x1 > x0) {
+                std::memset(Pixels + y * Width + x0, color, (size_t)(x1 - x0));
+            }
+        }
+    }
+
+    const unsigned char* GetFrontPixels() const { return Pixels; }
+    int GetFrontWidth() const { return Width; }
+    int GetFrontHeight() const { return Height; }
+
+    // Send the frame to the screen.
+    void RenderSurface()
+    {
+        if (!Pixels || !AmigaWindow) {
+            return;
+        }
+        const unsigned char* src = Pixels;
+        if (GameCursor.Data && Present && !Get_Mouse_State()) {
+            std::memcpy(Present, Pixels, (size_t)Width * Height);
+            int cx = MouseX - GameCursor.HotX, cy = MouseY - GameCursor.HotY;
+            for (int y = 0; y < GameCursor.H; y++) {
+                int py = cy + y;
+                if (py < 0 || py >= Height)
+                    continue;
+                for (int x = 0; x < GameCursor.W; x++) {
+                    int px = cx + x;
+                    if (px < 0 || px >= Width)
+                        continue;
+                    unsigned char c = GameCursor.Data[y * GameCursor.W + x];
+                    if (c != 0) {
+                        Present[py * Width + px] = c;
+                    }
+                }
+            }
+            src = Present;
+        }
+        WritePixelArray((APTR)src, 0, 0, (UWORD)Width, AmigaWindow->RPort, 0, 0, (UWORD)Width, (UWORD)Height,
+                        RECTFMT_LUT8);
+    }
+
+private:
+    int Width;
+    int Height;
+    GBC_Enum Flags;
+    unsigned char* Raw;
+    unsigned char* Pixels;
+    unsigned char* PresentRaw = nullptr;
+    unsigned char* Present;
+};
+
+static void* WatchObj = nullptr;
+static void* WatchVptr = nullptr;
+static unsigned FrameNo = 0;
+unsigned KbdPolls = 0;
+extern volatile unsigned Amiga_Heartbeat;
+
+void Amiga_Watch(void* obj)
+{
+    WatchObj = obj;
+    WatchVptr = *(void**)obj;
+}
+
+static void Check_Watch()
+{
+    FrameNo++;
+    Amiga_Heartbeat++;
+    if ((FrameNo % 50) == 1) {
+        FILE* hf = std::fopen("RAM:cnc-log.txt", "a");
+        if (hf) {
+            std::fprintf(hf, "frame %u polls %u\n", FrameNo, KbdPolls);
+            std::fclose(hf);
+        }
+    }
+    if (WatchObj && *(void**)WatchObj != WatchVptr) {
+        FILE* f = std::fopen("RAM:cnc-log.txt", "a");
+        if (f) {
+            unsigned long* w = (unsigned long*)WatchObj;
+            std::fprintf(f, "WATCH frame %u: object %p vptr %p -> %p; words: %08lx %08lx %08lx %08lx\n", FrameNo, WatchObj, WatchVptr, *(void**)WatchObj, w[0], w[1], w[2], w[3]);
+            std::fclose(f);
+        }
+        WatchVptr = *(void**)WatchObj;
+    }
+}
+
+static bool DumpRequested = false;
+
+void Amiga_Request_Frame_Dump()
+{
+    DumpRequested = true;
+}
+
+static void Dump_Frame(const unsigned char* pixels, int w, int h)
+{
+    FILE* f = std::fopen("RAM:cnc-frame.bin", "wb");
+    if (!f) {
+        return;
+    }
+    unsigned char hdr[8] = {'C', 'N', 'C', 'F', (unsigned char)(w >> 8), (unsigned char)w, (unsigned char)(h >> 8), (unsigned char)h};
+    std::fwrite(hdr, 1, 8, f);
+    std::fwrite(RawPalette, 1, 768, f);
+    std::fwrite(pixels, 1, (size_t)w * h, f);
+    std::fclose(f);
+}
+
+void Video_Render_Frame()
+{
+    Check_Watch();
+    if (frontSurface) {
+        frontSurface->RenderSurface();
+        if (DumpRequested) {
+            DumpRequested = false;
+            Dump_Frame(frontSurface->GetFrontPixels(), frontSurface->GetFrontWidth(), frontSurface->GetFrontHeight());
+        }
+    }
+}
+
+/*
+** Video
+*/
+Video::Video()
+{
+}
+
+Video::~Video()
+{
+}
+
+Video& Video::Shared()
+{
+    static Video video;
+    return video;
+}
+
+VideoSurface* Video::CreateSurface(int w, int h, GBC_Enum flags)
+{
+    return new VideoSurfaceAmiga(w, h, flags);
+}
diff --git a/common/wwkeyboard_amiga.cpp b/common/wwkeyboard_amiga.cpp
index 25a983d..c134d5a 100644
--- a/common/wwkeyboard_amiga.cpp
+++ b/common/wwkeyboard_amiga.cpp
@@ -1,10 +1,104 @@
 // AmigaOS keyboard/mouse backend for Vanilla Conquer.
-// F2 stub: links and does nothing. F3 fills Fill_Buffer_From_System from the
-// Intuition window IDCMP (RAWKEY, mouse) and maps Amiga raw codes to VK_*.
+// Events come from the IDCMP port of the window opened by video_amiga.cpp.
+// Amiga raw key codes are mapped to the Windows-style VK_* codes the engine uses.
+// Ctrl-C ends the program (needed for AmiAgent stop/deploy).
 #include "macros.h"
 #include "wwkeyboard.h"
 #include "video.h"
 #include "settings.h"
+#include <cstdlib>
+#include <cstdio>
+
+#include <exec/types.h>
+#include <intuition/intuition.h>
+#include <devices/inputevent.h>
+#include <dos/dos.h>
+#include <proto/exec.h>
+#include <proto/intuition.h>
+
+struct Window* Amiga_Get_Window();
+void Amiga_Mouse_Set(int x, int y);
+void Amiga_Request_Frame_Dump();
+extern unsigned KbdPolls;
+extern volatile unsigned Amiga_Heartbeat;
+void Focus_Loss();
+void Focus_Restore();
+
+// Amiga raw key code -> VK_* (0 = unmapped).
+static unsigned char RawToVK[128];
+
+static void InitKeyMap()
+{
+    static bool done = false;
+    if (done) {
+        return;
+    }
+    done = true;
+    unsigned char* m = RawToVK;
+    // top row 1..9 0
+    for (int i = 0; i < 9; i++) {
