+        Amiga_Heartbeat++;
+        if (SetSignal(0, 0) & SIGBREAKF_CTRL_C) {
+            std::exit(0);
+        }
+        struct Window* win = Amiga_Get_Window();
+        if (!win) {
+            return;
+        }
