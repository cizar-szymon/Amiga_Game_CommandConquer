+        if (vk >= VK_A && vk <= VK_Z) {
+            return (KeyASCIIType)(shift ? ('A' + (vk - VK_A)) : ('a' + (vk - VK_A)));
+        }
+        if (vk >= VK_0 && vk <= VK_9) {
+            static const char shifted[] = ")!@#$%^&*(";
+            return (KeyASCIIType)(shift ? shifted[vk - VK_0] : ('0' + (vk - VK_0)));
+        }
+        switch (vk) {
+        case VK_SPACE:
+            return (KeyASCIIType)' ';
+        case VK_RETURN:
+            return (KeyASCIIType)13;
+        case VK_BACK:
+            return (KeyASCIIType)8;
+        case VK_TAB:
+            return (KeyASCIIType)9;
+        case VK_ESCAPE:
+            return (KeyASCIIType)27;
+        case VK_NONE_BA:
+            return (KeyASCIIType)(shift ? ':' : ';');
+        case VK_NONE_BB:
+            return (KeyASCIIType)(shift ? '+' : '=');
+        case VK_NONE_BC:
+            return (KeyASCIIType)(shift ? '<' : ',');
+        case VK_NONE_BD:
+            return (KeyASCIIType)(shift ? '_' : '-');
+        case VK_NONE_BE:
+            return (KeyASCIIType)(shift ? '>' : '.');
+        case VK_NONE_BF:
+            return (KeyASCIIType)(shift ? '?' : '/');
+        case VK_NONE_C0:
+            return (KeyASCIIType)(shift ? '~' : '`');
+        case VK_NONE_DB:
+            return (KeyASCIIType)(shift ? '{' : '[');
+        case VK_NONE_DC:
+            return (KeyASCIIType)(shift ? '|' : '\\');
+        case VK_NONE_DD:
+            return (KeyASCIIType)(shift ? '}' : ']');
+        case VK_NONE_DE:
+            return (KeyASCIIType)(shift ? '"' : '\'');
+        }
+        if (vk >= VK_NUMPAD0 && vk <= VK_NUMPAD9) {
+            return (KeyASCIIType)('0' + (vk - VK_NUMPAD0));
+        }
