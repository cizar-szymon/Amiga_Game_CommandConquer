+// ---- stream tracker for the movie sound (vqaaudio_amiga.cpp): the game task writes the audio data, the mixer plays it
+
+SampleTrackerTypeImp* Amiga_Stream_Open(int bits_per_sample, bool stereo, int rate)
+{
+    for (int i = 0; i < MAX_TRACKERS; ++i) {
+        SampleTrackerTypeImp& t = Trackers[i];
+        if (!t.Used) {
+            unsigned char* fifo = (unsigned char*)std::malloc(131072);
+            if (!fifo) {
+                return nullptr;
+            }
+            ObtainSemaphore(&MixLock);
+            std::memset(&t, 0, sizeof(t));
+            t.Used = true;
+            t.Bits = bits_per_sample;
+            t.Stereo = stereo;
+            t.Rate = (unsigned)rate;
+            t.Volume = 65536;
+            t.Fifo = fifo;
+            t.FifoSize = 131072;
+            ReleaseSemaphore(&MixLock);
+            return &t;
+        }
+    }
+    return nullptr;
+}
+
+// Free room in bytes.
+unsigned Amiga_Stream_Space(SampleTrackerTypeImp* st)
+{
+    return st->FifoSize - (st->FifoWr - st->FifoRd);
+}
+
+// Append data (the caller checked the room).
+void Amiga_Stream_Write(SampleTrackerTypeImp* st, const void* data, unsigned len)
+{
+    const unsigned char* d = (const unsigned char*)data;
+    unsigned wr = st->FifoWr;
+    for (unsigned i = 0; i < len; ++i) {
+        st->Fifo[(wr + i) & (st->FifoSize - 1)] = d[i];
+    }
+    st->FifoWr = wr + len;
+}
+
+void Amiga_Stream_Play(SampleTrackerTypeImp* st, bool play)
+{
+    st->Playing = play;
+}
+
+void Amiga_Stream_Close(SampleTrackerTypeImp* st)
+{
+    if (!st) {
+        return;
+    }
+    ObtainSemaphore(&MixLock);
+    st->Playing = false;
+    st->Used = false;
+    unsigned char* f = st->Fifo;
+    st->Fifo = nullptr;
+    ReleaseSemaphore(&MixLock);
+    if (f) {
+        std::free(f);
+    }
+}
