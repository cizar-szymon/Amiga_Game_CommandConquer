+bool Amiga_No_Movies()
+{
+    static int cached = -1;
+    if (cached < 0) {
+        FILE* f = std::fopen("PROGDIR:nomovies", "r");
+        cached = f ? 1 : 0;
+        if (f) {
+            std::fclose(f);
+        }
+    }
+    return cached == 1;
+}
