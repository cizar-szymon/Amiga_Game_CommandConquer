+/*
+** autoinput: scripted test input. Only active when PROGDIR:autoinput.on exists; the script is
+** PROGDIR:autoinput.txt, one command per line (frames = rendered frames):
+**   wait N | move X Y | click X Y | rclick X Y | drag X1 Y1 X2 Y2 | key NAME | dump | quit
+*/
+enum { A_WAIT, A_MOVE, A_DOWN, A_UP, A_KEYDOWN, A_KEYUP, A_DUMP, A_QUIT };
+struct AutoAct
+{
+    int type, a, b;
+};
+static std::vector<AutoAct> AutoList;
+static size_t AutoPos = 0;
+static unsigned AutoWaitUntil = 0;
+static bool AutoLoaded = false;
+static bool AutoActive = false;
+
+static int Name_To_VK(const char* n)
+{
+    if (!std::strcmp(n, "esc")) return VK_ESCAPE;
+    if (!std::strcmp(n, "return")) return VK_RETURN;
+    if (!std::strcmp(n, "space")) return VK_SPACE;
+    if (!std::strcmp(n, "tab")) return VK_TAB;
+    if (!std::strcmp(n, "up")) return VK_UP;
+    if (!std::strcmp(n, "down")) return VK_DOWN;
+    if (!std::strcmp(n, "left")) return VK_LEFT;
+    if (!std::strcmp(n, "right")) return VK_RIGHT;
+    if (n[0] == 'f' && n[1] >= '1' && n[1] <= '9' && !n[2]) return VK_F1 + (n[1] - '1');
+    if (!n[1] && n[0] >= 'a' && n[0] <= 'z') return VK_A + (n[0] - 'a');
+    if (!n[1] && n[0] >= '0' && n[0] <= '9') return VK_0 + (n[0] - '0');
+    return 0;
+}
+
+static void Auto_Load()
+{
+    AutoLoaded = true;
+    FILE* on = std::fopen("PROGDIR:autoinput.on", "r");
+    if (!on) {
+        return;
+    }
+    std::fclose(on);
+    FILE* f = std::fopen("PROGDIR:autoinput.txt", "r");
+    if (!f) {
+        return;
+    }
+    char line[128];
+    while (std::fgets(line, sizeof(line), f)) {
+        char cmd[24] = {0};
+        int a = 0, b = 0, c = 0, d = 0;
+        char name[16] = {0};
+        AutoAct x;
+        if (std::sscanf(line, "%23s", cmd) != 1 || cmd[0] == '#') {
+            continue;
+        }
+        if (!std::strcmp(cmd, "wait") && std::sscanf(line, "%*s %d", &a) == 1) {
+            x.type = A_WAIT; x.a = a; x.b = 0; AutoList.push_back(x);
+        } else if (!std::strcmp(cmd, "move") && std::sscanf(line, "%*s %d %d", &a, &b) == 2) {
+            x.type = A_MOVE; x.a = a; x.b = b; AutoList.push_back(x);
+        } else if ((!std::strcmp(cmd, "click") || !std::strcmp(cmd, "rclick")) && std::sscanf(line, "%*s %d %d", &a, &b) == 2) {
+            int btn = (cmd[0] == 'r') ? VK_RBUTTON : VK_LBUTTON;
+            x.type = A_MOVE; x.a = a; x.b = b; AutoList.push_back(x);
+            x.type = A_WAIT; x.a = 2; x.b = 0; AutoList.push_back(x);
+            x.type = A_DOWN; x.a = btn; x.b = 0; AutoList.push_back(x);
+            x.type = A_WAIT; x.a = 3; x.b = 0; AutoList.push_back(x);
+            x.type = A_UP; x.a = btn; x.b = 0; AutoList.push_back(x);
+        } else if (!std::strcmp(cmd, "drag") && std::sscanf(line, "%*s %d %d %d %d", &a, &b, &c, &d) == 4) {
+            x.type = A_MOVE; x.a = a; x.b = b; AutoList.push_back(x);
+            x.type = A_WAIT; x.a = 2; x.b = 0; AutoList.push_back(x);
+            x.type = A_DOWN; x.a = VK_LBUTTON; x.b = 0; AutoList.push_back(x);
+            x.type = A_WAIT; x.a = 2; x.b = 0; AutoList.push_back(x);
+            x.type = A_MOVE; x.a = (a + c) / 2; x.b = (b + d) / 2; AutoList.push_back(x);
+            x.type = A_WAIT; x.a = 2; x.b = 0; AutoList.push_back(x);
+            x.type = A_MOVE; x.a = c; x.b = d; AutoList.push_back(x);
+            x.type = A_WAIT; x.a = 3; x.b = 0; AutoList.push_back(x);
+            x.type = A_UP; x.a = VK_LBUTTON; x.b = 0; AutoList.push_back(x);
+        } else if (!std::strcmp(cmd, "key") && std::sscanf(line, "%*s %15s", name) == 1) {
+            int vk = Name_To_VK(name);
+            if (vk) {
+                x.type = A_KEYDOWN; x.a = vk; x.b = 0; AutoList.push_back(x);
+                x.type = A_WAIT; x.a = 2; x.b = 0; AutoList.push_back(x);
+                x.type = A_KEYUP; x.a = vk; x.b = 0; AutoList.push_back(x);
+            }
+        } else if (!std::strcmp(cmd, "dump")) {
+            x.type = A_DUMP; x.a = 0; x.b = 0; AutoList.push_back(x);
+        } else if (!std::strcmp(cmd, "quit")) {
+            x.type = A_QUIT; x.a = 0; x.b = 0; AutoList.push_back(x);
+        }
+    }
+    std::fclose(f);
+    AutoActive = !AutoList.empty();
+}
+
 class WWKeyboardClassAmiga : public WWKeyboardClass
 {
 public:
@@ -107,10 +201,57 @@ public:
     {
     }
 
+    void Run_Autoinput()
+    {
+        if (!AutoLoaded) {
+            Auto_Load();
+        }
+        if (!AutoActive) {
+            return;
+        }
+        unsigned now = Amiga_Frame_No();
+        while (AutoPos < AutoList.size() && now >= AutoWaitUntil) {
+            const AutoAct& x = AutoList[AutoPos++];
+            int mx, my;
+            switch (x.type) {
+            case A_WAIT:
+                AutoWaitUntil = now + (unsigned)x.a;
+                return;
+            case A_MOVE:
+                Amiga_Mouse_Set(x.a, x.b);
+                break;
+            case A_DOWN:
+            case A_UP:
+                Get_Video_Mouse(mx, my);
+                {
+                    FILE* lf = std::fopen("RAM:cnc-log.txt", "a");
+                    if (lf) {
+                        std::fprintf(lf, "AUTO %s btn %d at %d,%d frame %u\n", x.type == A_UP ? "up" : "down", x.a, mx, my, now);
+                        std::fclose(lf);
+                    }
+                }
+                Put_Mouse_Message((unsigned short)x.a, mx, my, x.type == A_UP);
+                break;
+            case A_KEYDOWN:
+                Put_Key_Message((unsigned short)x.a, false);
+                break;
+            case A_KEYUP:
+                Put_Key_Message((unsigned short)x.a, true);
+                break;
+            case A_DUMP:
+                Amiga_Request_Frame_Dump();
+                break;
+            case A_QUIT:
+                std::exit(0);
+            }
+        }
+    }
+
     virtual void Fill_Buffer_From_System(void)
     {
         InitKeyMap();
         KbdPolls++;
+        Run_Autoinput();
         Amiga_Heartbeat++;
         if (SetSignal(0, 0) & SIGBREAKF_CTRL_C) {
             std::exit(0);
