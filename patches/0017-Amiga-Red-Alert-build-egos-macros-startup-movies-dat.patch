From 28f1dcfc320cf414dd030f620b8a070b0fdeaa32 Mon Sep 17 00:00:00 2001
From: cizar-szymon <szymon@cs-lab.eu>
Date: Mon, 23 Nov 2026 01:23:13 +0100
Subject: [PATCH 17/26] Amiga: Red Alert build (egos macros, startup, movies,
 data label)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 redalert/conquer.cpp | 12 ++++++++++--
 redalert/egos.cpp    |  4 ++++
 redalert/startup.cpp | 19 +++++++++++++++++++
 3 files changed, 33 insertions(+), 2 deletions(-)

diff --git a/redalert/conquer.cpp b/redalert/conquer.cpp
index 4825ba4..d0f6d93 100644
--- a/redalert/conquer.cpp
+++ b/redalert/conquer.cpp
@@ -2359,6 +2359,14 @@ extern void Play_Movie_GlyphX(const char* movie_name, ThemeType theme, bool imme
 
 void Play_Movie(char const* name, ThemeType theme, bool clrscrn, bool immediate)
 {
+#ifdef __amigaos__
+    {
+        extern bool Amiga_No_Movies();
+        if (Amiga_No_Movies()) {
+            return; // no FMV player yet: PROGDIR:movies switches the movies on
+        }
+    }
+#endif
 #ifdef REMASTER_BUILD
     if (strcmp(name, "x") == 0 || strcmp(name, "X") == 0) {
         return;
@@ -3712,7 +3720,7 @@ static bool Change_Local_Dir(int cd)
     if (!_initialised) {
         for (int i = 0; i < CD_COUNT; ++i) {
             for (int j = 0; j < 3; ++j) {
-                std::string path = Paths.Concatenate_Paths(paths[j].c_str(), _vol_labels[i]);
+                std::string path = (_vol_labels[i][0] == '.' && !_vol_labels[i][1]) ? paths[j] : Paths.Concatenate_Paths(paths[j].c_str(), _vol_labels[i]); // AmigaDOS has no '.' directory
                 RawFileClass vol(path.c_str());
 
                 if (vol.Is_Directory()) {
@@ -3779,7 +3787,7 @@ static bool Change_Local_Dir(int cd)
     // If the data from the CD we want was detected, then double check it and set it as though we used the -CD command line.
     if (_detected & (1 << cd)) {
         for (int j = 0; j < 3; ++j) {
-            std::string path = Paths.Concatenate_Paths(paths[j].c_str(), _vol_labels[cd]);
+            std::string path = (_vol_labels[cd][0] == '.' && !_vol_labels[cd][1]) ? paths[j] : Paths.Concatenate_Paths(paths[j].c_str(), _vol_labels[cd]);
             RawFileClass vol(path.c_str());
 
             if (vol.Is_Directory()) {
diff --git a/redalert/egos.cpp b/redalert/egos.cpp
index a22d4e1..9044c8c 100644
--- a/redalert/egos.cpp
+++ b/redalert/egos.cpp
@@ -43,6 +43,10 @@ class EgoClass;
 #include "egos.h"
 #include "common/mssleep.h"
 #include "common/framelimit.h"
+#ifdef __amigaos__
+#undef Read // dos.library inline macros clash with CCFileClass::Read / GraphicViewPortClass::Lock
+#undef Lock
+#endif
 
 /*
 ** List of Ego Class instances
diff --git a/redalert/startup.cpp b/redalert/startup.cpp
index 0c4320a..b47de9a 100644
--- a/redalert/startup.cpp
+++ b/redalert/startup.cpp
@@ -275,9 +275,28 @@ int DLL_Startup(const char* command_line_in)
 }
 #endif //REMASTER_BUILD
 
+#ifdef __amigaos__
+extern "C" const char amiga_version_tag[];
+extern "C" unsigned long __stack;
+#endif
+
 int main(int argc, char* argv[])
 {
     UtfArgs args(argc, argv);
+#ifdef __amigaos__
+    {
+        extern void Amiga_Load_ToolTypes();
+        Amiga_Load_ToolTypes();
+        FILE* lf = fopen("RAM:cnc-log.txt", "w");
+        if (lf) {
+            fprintf(lf, "main=%p\n", (void*)&main);
+            fprintf(lf, "%s stack %lu\n", amiga_version_tag, __stack);
+            fclose(lf);
+        }
+        extern void Amiga_Start_Watchdog();
+        Amiga_Start_Watchdog();
+    }
+#endif
     WWDebugString("RA95 - Starting up.\n");
 
     if (Ram_Free(MEM_NORMAL) < 7000000) {
