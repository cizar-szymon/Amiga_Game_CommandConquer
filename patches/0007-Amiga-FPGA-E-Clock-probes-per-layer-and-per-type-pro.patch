     SleepReq->tr_time.tv_micro = us % 1000000u;
     DoIO((struct IORequest*)SleepReq);
 }
+/* Probe clock. Warp firmware 3075+ exposes the E-Clock counter in the FPGA (90 ns per read, low 32 bits);
+** otherwise ReadEClock() (0.5 us patched, 13 us unpatched). Only the probes use it, the game keeps ReadEClock. */
+static volatile ULONG* FpgaEclk = nullptr;
+static bool FpgaChecked = false;
+
+static void Fpga_Check()
+{
+    FpgaChecked = true;
+    struct Library* eb = OpenLibrary((CONST_STRPTR)"expansion.library", 0);
+    if (!eb) {
+        return;
+    }
+    struct ConfigDev* cd = FindConfigDev(NULL, 0x1400, 101);
+    if (cd) {
+        volatile ULONG* syscfg = (volatile ULONG*)((UBYTE*)cd->cd_BoardAddr + 0x5000);
+        if (syscfg[0] >= 0x0123456AUL) {
+            FpgaEclk = syscfg + 0x24 / 4;
+        }
+    }
+    CloseLibrary(eb);
+}
+
 unsigned long long Amiga_Prof_Now()
 {
-    struct EClockVal ev;
     if (!TimerBase) {
         return 0;
     }
+    if (!FpgaChecked) {
+        Fpga_Check();
+    }
+    if (FpgaEclk) {
+        static ULONG lastLo = 0, hi = 0;
+        ULONG lo = *FpgaEclk;
+        if (lo < lastLo) {
+            hi++;
+        }
+        lastLo = lo;
+        return ((unsigned long long)hi << 32) | lo;
+    }
+    struct EClockVal ev;
+    EFreq = ReadEClock(&ev);
+    return ((unsigned long long)ev.ev_hi << 32) | ev.ev_lo;
+}
+
+/* ReadEClock based time for the game itself (needs EFreq). */
+static unsigned long long Eclock_Now()
+{
+    struct EClockVal ev;
     EFreq = ReadEClock(&ev);
     return ((unsigned long long)ev.ev_hi << 32) | ev.ev_lo;
 }
@@ -655,7 +713,7 @@ unsigned long long Amiga_Micros64()
 {
     static unsigned long long t0 = 0;
     Prof_Open();
-    unsigned long long t = Amiga_Prof_Now();
+    unsigned long long t = Eclock_Now();
     if (t0 == 0) {
         t0 = t;
     }
@@ -742,7 +800,21 @@ void Video_Render_Frame()
                                  (unsigned long)(Amiga_Prof_Acc[10] * 1000000ULL / EFreq / 50), (unsigned long)(Amiga_Prof_Acc[6] * 1000000ULL / EFreq / 50));
                     std::fclose(sf);
                 }
-                for (int k = 0; k < 16; k++) {
+                {
+                    FILE* s2 = std::fopen("RAM:cnc-log.txt", "a");
+                    if (s2) {
+                        std::fprintf(s2, "SLOTS2 us/frame:");
+                        for (int k = 16; k < 64; k++) {
+                            unsigned long us = (unsigned long)(Amiga_Prof_Acc[k] * 1000000ULL / EFreq / 50);
+                            if (us) {
+                                std::fprintf(s2, " %d=%lu", k, us);
+                            }
+                        }
+                        std::fprintf(s2, "\n");
+                        std::fclose(s2);
+                    }
+                }
+                for (int k = 0; k < 64; k++) {
                     Amiga_Prof_Acc[k] = 0;
                 }
             }
