+++ b/common/amiga_prof.h
@@ -0,0 +1,48 @@
+// Scope timers for the Amiga port (ReadEClock based). PROF_SCOPE(id) adds the time of the
+// enclosing block to slot id; video_amiga.cpp prints the slots (us per frame) every 50 frames.
+#ifndef AMIGA_PROF_H
+#define AMIGA_PROF_H
+
+#ifdef __amigaos__
+extern unsigned long long Amiga_Prof_Now();
+extern unsigned long long Amiga_Prof_Acc[16];
+
+struct AmigaProfScope
+{
+    int Id;
+    unsigned long long T0;
+    explicit AmigaProfScope(int id)
+        : Id(id)
+        , T0(Amiga_Prof_Now())
+    {
+    }
+    ~AmigaProfScope()
+    {
+        Amiga_Prof_Acc[Id] += Amiga_Prof_Now() - T0;
+    }
+};
+#define PROF_SCOPE(id) AmigaProfScope amiga_prof_scope_##id(id)
+#else
+#define PROF_SCOPE(id) ((void)0)
+#endif
+
+/* slot ids */
+#define PROF_MAINLOOP 0
+#define PROF_MAPRENDER 1
+#define PROF_LOGIC 2
+#define PROF_BLT 3
+#define PROF_PRESENT 4
+#define PROF_INPUT 5
+#define PROF_SPRITES 6
+#define PROF_COLORCYCLE 7
+#define PROF_CALLBACK 8
+#define PROF_PALETTE 9
+#define PROF_FRAMELIMIT 10
+#define PROF_SYNCWAIT 11
+#define PROF_DRAWIT 12
+#define PROF_BUTTONS 13
+#define PROF_BLITDISP 14
+#define PROF_SORT 15
+#define PROF_SLEEP 6
+
+#endif
