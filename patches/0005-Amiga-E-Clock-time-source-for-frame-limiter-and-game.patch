+                    std::fprintf(sf, "SLOTS us/frame: mainloop %lu maprender %lu logic %lu blt %lu present %lu input %lu colorcycle %lu callback %lu palette %lu syncwait %lu drawit %lu buttons %lu blitdisplay %lu sort %lu framelimiter %lu sleep %lu\n",
+                                 (unsigned long)(Amiga_Prof_Acc[0] * 1000000ULL / EFreq / 50), (unsigned long)(Amiga_Prof_Acc[1] * 1000000ULL / EFreq / 50),
+                                 (unsigned long)(Amiga_Prof_Acc[2] * 1000000ULL / EFreq / 50), (unsigned long)(Amiga_Prof_Acc[3] * 1000000ULL / EFreq / 50),
+                                 (unsigned long)(Amiga_Prof_Acc[4] * 1000000ULL / EFreq / 50), (unsigned long)(Amiga_Prof_Acc[5] * 1000000ULL / EFreq / 50),
+                                 (unsigned long)(Amiga_Prof_Acc[7] * 1000000ULL / EFreq / 50), (unsigned long)(Amiga_Prof_Acc[8] * 1000000ULL / EFreq / 50),
+                                 (unsigned long)(Amiga_Prof_Acc[9] * 1000000ULL / EFreq / 50), (unsigned long)(Amiga_Prof_Acc[11] * 1000000ULL / EFreq / 50),
+                                 (unsigned long)(Amiga_Prof_Acc[12] * 1000000ULL / EFreq / 50), (unsigned long)(Amiga_Prof_Acc[13] * 1000000ULL / EFreq / 50),
+                                 (unsigned long)(Amiga_Prof_Acc[14] * 1000000ULL / EFreq / 50), (unsigned long)(Amiga_Prof_Acc[15] * 1000000ULL / EFreq / 50),
+                                 (unsigned long)(Amiga_Prof_Acc[10] * 1000000ULL / EFreq / 50), (unsigned long)(Amiga_Prof_Acc[6] * 1000000ULL / EFreq / 50));
+                    std::fclose(sf);
+                }
+                for (int k = 0; k < 16; k++) {
+                    Amiga_Prof_Acc[k] = 0;
+                }
