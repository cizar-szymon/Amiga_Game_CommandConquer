+#ifdef __amigaos__
+/*
+** Amiga: std::chrono::steady_clock is far too coarse here (the limiter then sleeps for tens of
+** milliseconds per frame), so the schedule runs on the E-Clock in microseconds.
+*/
+void Frame_Limiter(FrameLimitFlags flags)
+{
+    PROF_SCOPE(PROF_FRAMELIMIT);
+    static long long frame_start = (long long)Amiga_Micros64();
+    static long long render_avg = 0; /* microseconds */
+
+    long long render_start = (long long)Amiga_Micros64();
+    long long render_remaining = frame_start - render_start;
+
+    if (!(flags & FrameLimitFlags::FL_FORCE_RENDER) && render_remaining > render_avg) {
+        if (!(flags & FrameLimitFlags::FL_NO_BLOCK)) {
+            us_sleep(unsigned(render_remaining));
+        } else {
+            us_sleep(1000); // Unconditionally yield for minimum time.
+        }
+        return;
+    }
+
+    Video_Render_Frame();
+
+    long long render_end = (long long)Amiga_Micros64();
+    long long render_time = render_end - render_start;
+    render_avg = (render_avg + render_time) / 2;
+
+    if (Settings.Video.FrameLimit > 0 && !(flags & FrameLimitFlags::FL_NO_BLOCK)) {
+        long long min_frame_time = 1000000 / Settings.Video.FrameLimit;
+        long long cur_frame_time = render_end - frame_start;
+        if (cur_frame_time < min_frame_time) {
+            frame_start += min_frame_time;
+            us_sleep(unsigned(min_frame_time - cur_frame_time));
+        } else {
+            frame_start = render_end;
+        }
+    }
+}
+#else
 void Frame_Limiter(FrameLimitFlags flags)
 {
+    PROF_SCOPE(PROF_FRAMELIMIT);
     static auto frame_start = std::chrono::steady_clock::now();
 #ifdef NEW_VIDEO_BUILD
     static auto render_avg = 0;
@@ -58,3 +104,4 @@ void Frame_Limiter(FrameLimitFlags flags)
         }
     }
 }
+#endif // __amigaos__
