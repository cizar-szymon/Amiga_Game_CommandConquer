-static unsigned long long Prof_Now()
+unsigned long long Amiga_Prof_Acc[16];
+static struct MsgPort* SleepPort = nullptr;
+static struct timerequest* SleepReq = nullptr;
+
+/* Precise sleep (UNIT_MICROHZ). Below ~100 us the request costs more than it saves: return. */
+void Amiga_Sleep_Us(unsigned us)
+{
+    static unsigned calls = 0;
+    calls++;
+    if (calls > 200 && calls <= 260) {
+        FILE* sf = std::fopen("RAM:cnc-log.txt", "a");
+        if (sf) {
+            std::fprintf(sf, "SLEEP call %u us %u\n", calls, us);
+            std::fclose(sf);
+        }
+    }
+    if (us < 100) {
+        return;
+    }
+    if (!SleepReq) {
+        SleepPort = CreateMsgPort();
+        if (SleepPort) {
+            SleepReq = (struct timerequest*)CreateIORequest(SleepPort, sizeof(struct timerequest));
+            if (SleepReq && OpenDevice((CONST_STRPTR)"timer.device", UNIT_MICROHZ, (struct IORequest*)SleepReq, 0) != 0) {
+                DeleteIORequest((struct IORequest*)SleepReq);
+                SleepReq = nullptr;
+            }
+        }
+        if (!SleepReq) {
+            Delay(1);
+            return;
+        }
+    }
+    SleepReq->tr_node.io_Command = TR_ADDREQUEST;
+    SleepReq->tr_time.tv_secs = us / 1000000u;
+    SleepReq->tr_time.tv_micro = us % 1000000u;
+    DoIO((struct IORequest*)SleepReq);
+}
+unsigned long long Amiga_Prof_Now()
 {
     struct EClockVal ev;
     if (!TimerBase) {
@@ -530,6 +572,25 @@ static unsigned long long Prof_Now()
     return ((unsigned long long)ev.ev_hi << 32) | ev.ev_lo;
 }
 
+/* Monotonic microseconds since the first call (E-Clock, 709379 Hz on PAL). */
+unsigned long long Amiga_Micros64()
+{
+    static unsigned long long t0 = 0;
+    Prof_Open();
+    unsigned long long t = Amiga_Prof_Now();
+    if (t0 == 0) {
+        t0 = t;
+    }
+    return EFreq ? ((t - t0) * 1000000ULL) / EFreq : 0;
+}
+
+/* Milliseconds for the game timers; 32-bit arithmetic is enough for 49 days. */
+unsigned long long Amiga_Millis64()
+{
+    return Amiga_Micros64() / 1000ULL;
+}
