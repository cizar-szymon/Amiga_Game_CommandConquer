             if (pf) {
@@ -588,6 +650,24 @@ void Video_Render_Frame()
                 std::fprintf(pf, "PROF 50 frames: render %lu us/frame, wall %lu ms (%lu fps)\n", (unsigned long)((ProfRender * 1000000ULL / EFreq) / 50), (unsigned long)(dt * 1000ULL / EFreq), dt ? (unsigned long)(50ULL * EFreq / dt) : 0UL);
                 std::fclose(pf);
             }
+            {
