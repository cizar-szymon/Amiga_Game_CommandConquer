@@ -806,7 +807,7 @@ void Video_Render_Frame()
                     FILE* s2 = std::fopen("RAM:cnc-log.txt", "a");
                     if (s2) {
                         std::fprintf(s2, "SLOTS2 us/frame:");
-                        for (int k = 16; k < 64; k++) {
+                        for (int k = 16; k < 96; k++) {
                             unsigned long us = (unsigned long)(Amiga_Prof_Acc[k] * 1000000ULL / EFreq / 50);
                             if (us) {
                                 std::fprintf(s2, " %d=%lu", k, us);
@@ -831,6 +832,18 @@ void Video_Render_Frame()
                         std::fclose(s3);
                     }
                 }
+                {
+                    FILE* s4 = std::fopen("RAM:cnc-log.txt", "a");
+                    if (s4) {
+                        std::fprintf(s4, "COUNTS per frame: mark_foot %lu mark_object %lu occupy_down %lu occupy_up %lu overlap_down %lu overlap_up %lu redraw_objects %lu\n",
+                                     Amiga_Prof_Cnt[0] / 50, Amiga_Prof_Cnt[1] / 50, Amiga_Prof_Cnt[2] / 50, Amiga_Prof_Cnt[3] / 50, Amiga_Prof_Cnt[4] / 50,
+                                     Amiga_Prof_Cnt[5] / 50, Amiga_Prof_Cnt[6] / 50);
+                        std::fclose(s4);
+                    }
+                    for (int k = 0; k < 32; k++) {
+                        Amiga_Prof_Cnt[k] = 0;
+                    }
+                }
                 for (int k = 0; k < 96; k++) {
                     Amiga_Prof_Acc[k] = 0;
                 }
