diff --git a/common/amiga_prof.h b/common/amiga_prof.h
index 2220e9f..7e50670 100644
--- a/common/amiga_prof.h
+++ b/common/amiga_prof.h
@@ -3,11 +3,12 @@
 #ifndef AMIGA_PROF_H
 #define AMIGA_PROF_H
 
-#ifdef __amigaos__
+#if defined(__amigaos__) && defined(CNC_PROFILE)
 extern unsigned long long Amiga_Prof_Now();
 extern unsigned long long Amiga_Prof_Acc[96];
 extern unsigned long Amiga_Prof_Calls[16];
 extern unsigned long Amiga_Prof_Pixels[16];
+extern unsigned long Amiga_Prof_Cnt[32];
 
 struct AmigaProfScope
 {
@@ -25,9 +26,31 @@ struct AmigaProfScope
 };
 #define PROF_SCOPE(id) AmigaProfScope amiga_prof_scope_##id(id)
 #define PROF_SCOPE_N(var, id) AmigaProfScope var(id)
+#define PROF_COUNT(id) (Amiga_Prof_Cnt[id]++)
+
+/* Time only the outermost activation of a recursive function; nested activations go to slot 23. */
+struct AmigaProfTop
+{
+    int* Depth;
+    AmigaProfScope Scope;
+    AmigaProfTop(int* d, int id)
+        : Depth(d)
+        , Scope(*d == 0 ? id : 23)
+    {
+        ++*Depth;
+    }
+    ~AmigaProfTop()
+    {
+        --*Depth;
+    }
+};
+#define PROF_SCOPE_TOP(var, id) static int var##_depth = 0; AmigaProfTop var(&var##_depth, id)
+
 #else
 #define PROF_SCOPE(id) ((void)0)
 #define PROF_SCOPE_N(var, id) ((void)0)
+#define PROF_COUNT(id) ((void)0)
+#define PROF_SCOPE_TOP(var, id) ((void)0)
 #endif
 
 /* slot ids */
