+// AmigaOS keyboard/mouse backend for Vanilla Conquer.
+// F2 stub: links and does nothing. F3 fills Fill_Buffer_From_System from the
+// Intuition window IDCMP (RAWKEY, mouse) and maps Amiga raw codes to VK_*.
+#include "macros.h"
+#include "wwkeyboard.h"
+#include "video.h"
+#include "settings.h"
+
+class WWKeyboardClassAmiga : public WWKeyboardClass
+{
+public:
+    virtual ~WWKeyboardClassAmiga()
+    {
+    }
+    virtual void Fill_Buffer_From_System(void)
+    {
+    }
+    virtual KeyASCIIType To_ASCII(unsigned short key)
+    {
+        (void)key;
+        return KA_NONE;
+    }
+};
+
+WWKeyboardClass* CreateWWKeyboardClass(void)
+{
+    return new WWKeyboardClassAmiga;
+}
