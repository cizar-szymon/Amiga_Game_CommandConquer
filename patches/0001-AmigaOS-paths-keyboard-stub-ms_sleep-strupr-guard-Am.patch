index 0000000..3289cf1
--- /dev/null
+++ b/common/paths_amiga.cpp
@@ -0,0 +1,102 @@
+// AmigaOS paths for Vanilla Conquer (port for AmigaOS 3.x, Warp RTG).
+// Everything is relative to the program drawer (PROGDIR:), no POSIX home or /proc.
+#include "paths.h"
+#include "debugstring.h"
+#include <cstring>
+#include <string>
+#include <proto/dos.h>
+#include <dos/dos.h>
+
+const char* PathsClass::Program_Path()
+{
+    if (ProgramPath.empty()) {
+        ProgramPath = "PROGDIR:";
+    }
+    return ProgramPath.c_str();
+}
+
+const char* PathsClass::Data_Path()
+{
+    if (DataPath.empty()) {
+        DataPath = "PROGDIR:data";
+        if (!Suffix.empty()) {
+            DataPath += SEP + Suffix;
+        }
+    }
+    return DataPath.c_str();
+}
+
+const char* PathsClass::User_Path()
+{
+    if (UserPath.empty()) {
+        UserPath = "PROGDIR:user";
+        if (!Suffix.empty()) {
+            UserPath += SEP + Suffix;
+        }
+        Create_Directory(UserPath.c_str());
+    }
+    return UserPath.c_str();
+}
+
+bool PathsClass::Create_Directory(const char* dirname)
+{
+    if (dirname == nullptr) {
+        return true;
+    }
+    std::string temp = dirname;
+    size_t pos = temp.find(':');
+    pos = (pos == std::string::npos) ? 0 : pos + 1;
+    bool ret = true;
+    for (;;) {
+        pos = temp.find('/', pos);
+        std::string part = temp.substr(0, pos);
+        if (!part.empty() && part[part.size() - 1] != ':') {
+            BPTR lock = Lock((CONST_STRPTR)part.c_str(), SHARED_LOCK);
+            if (lock) {
+                UnLock(lock);
+            } else {
+                BPTR nl = CreateDir((CONST_STRPTR)part.c_str());
+                if (nl) {
+                    UnLock(nl);
+                } else {
+                    ret = false;
+                    break;
+                }
+            }
+        }
+        if (pos == std::string::npos) {
+            break;
+        }
+        ++pos;
+    }
+    return ret;
+}
+
+bool PathsClass::Is_Absolute(const char* path)
+{
+    return path != nullptr && std::strchr(path, ':') != nullptr;
+}
+
+std::string PathsClass::Concatenate_Paths(const char* path1, const char* path2)
+{
+    std::string r(path1);
+    if (!r.empty() && r[r.size() - 1] != ':' && r[r.size() - 1] != '/') {
+        r += SEP;
+    }
+    return r + path2;
+}
+
+std::string PathsClass::Get_Filename(const char* path)
+{
+    const char* p = path + std::strlen(path);
+    while (p > path && p[-1] != '/' && p[-1] != ':') {
+        --p;
+    }
+    return std::string(p);
+}
+
+std::string PathsClass::Argv_Path(const char* cmd_arg)
+{
+    (void)cmd_arg;
+    return std::string("PROGDIR:");
+}
