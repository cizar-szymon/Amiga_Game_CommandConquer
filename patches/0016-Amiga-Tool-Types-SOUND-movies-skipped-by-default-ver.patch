index 0000000..106664f
--- /dev/null
+++ b/common/amiga_tooltypes.cpp
@@ -0,0 +1,90 @@
+// Tool Types of the program icon (Workbench or Shell start). Read once, in the main task, before main():
+// the sound process has no program name of its own. Keys are case-insensitive; the value is returned as is.
+#include <cstring>
+#include <exec/types.h>
+#include <dos/dos.h>
+#include <workbench/workbench.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/icon.h>
+#include <workbench/startup.h>
+
+extern struct WBStartup* _WBenchMsg; // libnix: set when started from Workbench
+
+struct Library* IconBase = nullptr;
+
+namespace
+{
+struct Loader
+{
+    char Keys[8][16];
+    char Values[8][32];
+    int Count;
+    Loader() : Count(0) {}
+    void Load()
+    {
+        char name[128];
+        if (_WBenchMsg && _WBenchMsg->sm_NumArgs > 0 && _WBenchMsg->sm_ArgList[0].wa_Name) {
+            std::strncpy(name, (const char*)_WBenchMsg->sm_ArgList[0].wa_Name, sizeof(name) - 1);
+            name[sizeof(name) - 1] = 0;
+        } else if (!GetProgramName((STRPTR)name, sizeof(name))) {
+            return;
+        }
+        const char* base = name;
+        for (const char* p = name; *p; p++) {
+            if (*p == '/' || *p == ':') {
+                base = p + 1;
+            }
+        }
+        char path[160];
+        std::strcpy(path, "PROGDIR:");
+        std::strncat(path, base, 120);
+        IconBase = OpenLibrary((CONST_STRPTR)"icon.library", 0);
+        if (!IconBase) {
+            return;
+        }
+        struct DiskObject* dobj = GetDiskObject((CONST_STRPTR)path);
+        if (dobj && dobj->do_ToolTypes) {
+            for (char** tt = (char**)dobj->do_ToolTypes; *tt && Count < 8; tt++) {
+                const char* s = *tt;
+                if (s[0] == '(' || !std::strchr(s, '=')) {
+                    continue; // "(SOUND=AHI)": switched off, only a hint
+                }
+                int k = 0;
+                while (*s && *s != '=' && k < 15) {
+                    char c = *s++;
+                    Keys[Count][k++] = (c >= 'a' && c <= 'z') ? (char)(c - 32) : c;
+                }
+                Keys[Count][k] = 0;
+                while (*s && *s != '=') {
+                    s++;
+                }
+                if (*s == '=') {
+                    s++;
+                }
+                std::strncpy(Values[Count], s, 31);
+                Values[Count][31] = 0;
+                Count++;
+            }
+        }
+        (void)dobj; // kept for the lifetime of the program
+    }
+};
+
+Loader TheLoader;
+} // namespace
+
+void Amiga_Load_ToolTypes()
+{
+    TheLoader.Load();
+}
+
+const char* Amiga_ToolType(const char* key)
+{
+    for (int i = 0; i < TheLoader.Count; i++) {
+        if (!std::strcmp(TheLoader.Keys[i], key)) {
+            return TheLoader.Values[i];
+        }
+    }
+    return nullptr;
+}
diff --git a/common/soundio_amiga.cpp b/common/soundio_amiga.cpp
index c12fccc..3906883 100644
--- a/common/soundio_amiga.cpp
+++ b/common/soundio_amiga.cpp
@@ -511,6 +511,14 @@ static const char* Read_Mode_File()
         }
         std::fclose(f);
     }
+    if (!word[0]) {
+        extern const char* Amiga_ToolType(const char*);
+        const char* t = Amiga_ToolType("SOUND");
+        for (int i = 0; t && t[i] && i < 15; i++) {
+            word[i] = (t[i] >= 'A' && t[i] <= 'Z') ? (char)(t[i] + 32) : t[i];
+            word[i + 1] = 0;
+        }
+    }
     return word;
 }
 
