--- a/tiberiandawn/gscreen.cpp
+++ b/tiberiandawn/gscreen.cpp
@@ -478,8 +478,20 @@ void GScreenClass::Blit_Display(void)
         WWMouse->Erase_Mouse(&HidPage, false);
     } else {
 #else //(0)
+#ifdef __amigaos__
+    /*
+    ** The whole HidPage is what gets shown, so do not copy it to SeenBuff: the video layer presents
+    ** straight from HidPage and only fills SeenBuff if something draws on it directly.
+    */
+    {
+        extern void Amiga_Present_From(const void* pixels, int width, int height);
+        WWMouse->Draw_Mouse(&HidPage);
+        Amiga_Present_From((const void*)HidPage.Get_Offset(), HidPage.Get_Width(), HidPage.Get_Height());
+    }
+#else
     WWMouse->Draw_Mouse(&HidPage);
     HidPage.Blit(SeenBuff, 0, 0, 0, 0, HidPage.Get_Width(), HidPage.Get_Height(), false);
+#endif
 #ifdef CHEAT_KEYS
     Add_Current_Screen();
 #endif
