+++ b/tiberiandawn/bugdlg.cpp
@@ -0,0 +1,284 @@
+// F10 on the Amiga: a bug report. The state of the game is written to PROGDIR:user (bugNNN.txt, a picture of the screen,
+// a saved game); with a TCP/IP stack a dialog in the style of the game's menus asks for an e-mail address (optional) and
+// a few words about the problem and sends all to the game server (common/report_amiga.cpp). Without the stack the files
+// only stay in the drawer.
+#ifdef __amigaos__
+#include "function.h"
+#define CNC_PORT_VERSION "0.2"
+// Shell `Version` command; the release number is bumped for every build given to users.
+extern "C" const char amiga_version_tag[] __attribute__((used)) = "$VER: TiberianDawn " CNC_PORT_VERSION " (24.11.2026)";
+#include "../common/report_amiga.h"
+#include "common/framelimit.h"
+#include <cstdio>
+#include <cstring>
+
+int Bug_Next_Number();
+void Bug_Server(char* host, int size, int* port);
+void Bug_Email_Load(char* email, int size);
+void Bug_Email_Save(const char* email);
+void Bug_Path(char* out, int size, int n, const char* suffix);
+bool Amiga_Write_Screen_BMP(const char* path);
+
+#define BUG_VERSION "CnCTD-" CNC_PORT_VERSION
+
+static void Bug_Log(const char* format, int a, const char* b)
+{
+    FILE* f = std::fopen("RAM:cnc-log.txt", "a");
+    if (f) {
+        std::fprintf(f, format, a, b);
+        std::fprintf(f, "%c", 10);
+        std::fclose(f);
+    }
+}
+
+static void Bug_Write_Text(int n, const char* path)
+{
+    FILE* f = std::fopen(path, "w");
+    if (!f) {
+        return;
+    }
+    char machine[160];
+    Report_Machine(machine, sizeof(machine));
+    std::fprintf(f, "Command & Conquer: Tiberian Dawn (Amiga) bug report %d\nversion %s\nmachine %s\n", n, BUG_VERSION, machine);
+    std::fprintf(f, "game type %d, scenario %d, frame %d\n", (int)GameToPlay, (int)Scen.Scenario, (int)Frame);
+    if (PlayerPtr) {
+        std::fprintf(f, "player house %d, credits %d\n", (int)PlayerPtr->Class->House, (int)PlayerPtr->Credits);
+    }
+    std::fprintf(f, "screen %dx%d\n", (int)SeenBuff.Get_Width(), (int)SeenBuff.Get_Height());
+    std::fclose(f);
+}
+
+static void Bug_Redraw_Map()
+{
+    if (InMainLoop) {
+        HiddenPage.Clear();
+        Map.Flag_To_Redraw(true);
+        Map.Render();
+    }
+}
+
+// The dialog: true = SEND (email and text filled in), false = cancelled.
+static bool Bug_Dialog(char* email, int email_size, char* text, int text_size)
+{
+    int factor = (SeenBuff.Get_Width() == 320) ? 1 : 2;
+    int d_dialog_w = 250 * factor;
+    int d_dialog_h = 150 * factor;
+    int d_dialog_x = (SeenBuff.Get_Width() - d_dialog_w) >> 1;
+    int d_dialog_y = (SeenBuff.Get_Height() - d_dialog_h) >> 1;
+    int d_dialog_cx = d_dialog_x + (d_dialog_w >> 1);
+    int d_txt_h = 11 * factor;
+    int d_margin = 7 * factor;
+    int d_edit_w = d_dialog_w - (d_margin * 2);
+    int d_edit_h = 13 * factor;
+    int d_edit_x = d_dialog_x + d_margin;
+    int y_caption = d_dialog_y + d_margin;
+    int y_label1 = y_caption + d_txt_h + 3 * factor;
+    int y_edit0 = y_label1 + d_txt_h;
+    int y_label2 = y_edit0 + d_edit_h + 4 * factor;
+    int y_edit1 = y_label2 + d_txt_h;
+    int d_button_w = 50 * factor;
+    int d_button_h = 13 * factor;
+    int d_button_x = d_dialog_cx - d_button_w - d_margin;
+    int d_button_y = d_dialog_y + d_dialog_h - d_button_h - d_margin;
+    int d_cancel_x = d_dialog_cx + d_margin;
+
+    enum
+    {
+        BUTTON_SEND = 100,
+        BUTTON_CANCEL,
+        BUTTON_E0,
+        BUTTON_E1,
+        BUTTON_E2,
+        BUTTON_E3,
+    };
+
+    char line[3][96];
+    std::memset(line, 0, sizeof(line));
+    char emailbuf[64];
+    std::strncpy(emailbuf, email, sizeof(emailbuf) - 1);
+    emailbuf[sizeof(emailbuf) - 1] = 0;
+
+    TextPrintType bf = (TextPrintType)(TPF_6PT_GRAD | TPF_CENTER | TPF_NOSHADOW);
+    TextButtonClass sendbtn(BUTTON_SEND, "SEND", bf, d_button_x, d_button_y, d_button_w);
+    TextButtonClass cancelbtn(BUTTON_CANCEL, "CANCEL", bf, d_cancel_x, d_button_y, d_button_w);
+    TextPrintType ef = (TextPrintType)(TPF_6PT_GRAD | TPF_USE_GRAD_PAL | TPF_NOSHADOW);
+    EditClass edit0(BUTTON_E0, emailbuf, 60, ef, d_edit_x, y_edit0, d_edit_w, -1, EditClass::ALPHANUMERIC);
+    EditClass edit1(BUTTON_E1, line[0], 90, ef, d_edit_x, y_edit1, d_edit_w, -1, EditClass::ALPHANUMERIC);
+    EditClass edit2(BUTTON_E2, line[1], 90, ef, d_edit_x, y_edit1 + d_edit_h + 2 * factor, d_edit_w, -1, EditClass::ALPHANUMERIC);
+    EditClass edit3(BUTTON_E3, line[2], 90, ef, d_edit_x, y_edit1 + 2 * (d_edit_h + 2 * factor), d_edit_w, -1, EditClass::ALPHANUMERIC);
+    EditClass* edits[4] = {&edit0, &edit1, &edit2, &edit3};
+
+    Set_Logic_Page(SeenBuff);
+    ControlClass* commands = &sendbtn;
+    cancelbtn.Add_Tail(*commands);
+    for (int i = 0; i < 4; i++) {
+        edits[i]->Add_Tail(*commands);
+    }
+
+    int focus = emailbuf[0] ? 1 : 0;
+    bool set_focus = true;
+    bool display = true;
+    bool process = true;
+    bool send = false;
+    Keyboard->Clear();
+    while (process) {
+        Call_Back();
+        if (AllSurfaces.SurfacesRestored) {
+            AllSurfaces.SurfacesRestored = false;
+            display = true;
+        }
+        if (display) {
+            Hide_Mouse();
+            Bug_Redraw_Map();
+            Dialog_Box(d_dialog_x, d_dialog_y, d_dialog_w, d_dialog_h);
+            TextPrintType tc = (TextPrintType)(TPF_6PT_GRAD | TPF_USE_GRAD_PAL | TPF_CENTER | TPF_NOSHADOW);
+            Fancy_Text_Print("BUG REPORT", d_dialog_cx, y_caption, CC_GREEN, TBLACK, tc);
+            Fancy_Text_Print("YOUR E-MAIL (OPTIONAL):", d_edit_x, y_label1, CC_GREEN, TBLACK, ef);
+            Fancy_Text_Print("WHAT HAPPENED:", d_edit_x, y_label2, CC_GREEN, TBLACK, ef);
+            commands->Flag_List_To_Redraw();
+            Show_Mouse();
+            display = false;
+        }
+        KeyNumType input = commands->Input();
+        if (set_focus) {
+            set_focus = false;
+            edits[focus]->Set_Focus();
+            edits[focus]->Flag_To_Redraw();
+        }
+        // Return in a field goes to the next one (in the last one it sends), Tab goes on too
+        int from = -1;
+        for (int i = 0; i < 3; i++) {
+            if (input == (KeyNumType)((BUTTON_E0 + i) | KN_BUTTON)) {
+                from = i;
+            }
+        }
+        if (input == KN_TAB) {
+            from = focus;
+            for (int i = 0; i < 4; i++) {
+                if (edits[i]->Has_Focus()) {
+                    from = i;
+                }
+            }
+        }
+        if (from >= 0) {
+            edits[from]->Clear_Focus();
+            focus = (from + 1) & 3;
+            set_focus = true;
+            continue;
+        }
+        if (input == (KeyNumType)(BUTTON_E3 | KN_BUTTON) || input == KN_RETURN) {
+            input = (KeyNumType)(BUTTON_SEND | KN_BUTTON);
+        }
+        switch (input) {
+        case (BUTTON_SEND | KN_BUTTON): {
+            int len = 0;
+            text[0] = 0;
+            for (int i = 0; i < 3; i++) {
+                if (line[i][0]) {
+                    len += std::snprintf(text + len, text_size - len, "%s%s", len ? " " : "", line[i]);
+                }
+            }
+            std::strncpy(email, emailbuf, email_size - 1);
+            email[email_size - 1] = 0;
+            send = true;
+            process = false;
+            break;
+        }
+        case KN_ESC:
+        case (BUTTON_CANCEL | KN_BUTTON):
+            process = false;
+            break;
+        default:
+            break;
+        }
+        Frame_Limiter();
+    }
+    return send;
+}
+
+void Amiga_Bug_Report()
+{
+    static bool busy = false;
+    if (busy) {
+        return;
+    }
+    busy = true;
+    int n = Bug_Next_Number();
+    if (n == 0) {
+        busy = false;
+        return;
+    }
+    char txt[96], bmp[96], sav[96];
+    Bug_Path(txt, sizeof(txt), n, ".txt");
+    Bug_Path(bmp, sizeof(bmp), n, "-screen.bmp");
+    Bug_Path(sav, sizeof(sav), n, ".sav");
+    Amiga_Write_Screen_BMP(bmp);
+    char savname[32];
+    std::snprintf(savname, sizeof(savname), "bug%03d.sav", n);
+    bool saved = false;
+    if (InMainLoop && PlayerPtr) {
+        saved = Save_Game(savname, "Bug report");
+    }
+    Bug_Write_Text(n, txt);
+
+    bool net = Report_Network() != 0;
+    Bug_Log("bug report %d: files written, TCP/IP stack %s", n, net ? "running" : "not running");
+    if (!net) {
+        char msg[160];
+        std::snprintf(msg, sizeof(msg), "Bug report %d saved in the user drawer (bug%03d.*). No TCP/IP stack: it cannot be sent.", n, n);
+        WWMessageBox().Process(msg);
+        Bug_Redraw_Map();
+        Map.Flag_To_Redraw(true);
+        busy = false;
+        return;
+    }
+    char email[64], text[300];
+    Bug_Email_Load(email, sizeof(email));
+    text[0] = 0;
+    if (Bug_Dialog(email, sizeof(email), text, sizeof(text))) {
+        Bug_Email_Save(email);
+        char host[64], machine[160];
+        int port;
+        Bug_Server(host, sizeof(host), &port);
+        Report_Machine(machine, sizeof(machine));
+        const char* files[4];
+        int nf = 0;
+        files[nf++] = txt;
+        files[nf++] = bmp;
+        if (saved) {
+            files[nf++] = sav;
+        }
+        if (!Report_Send(host, port, BUG_VERSION, "F10", email, text, machine, files, nf)) {
+            WWMessageBox().Process("The previous report is still being sent.");
+        } else {
+            // the process sends in the background; the game waits for the answer behind a little window
+            char res[64];
+            int ok = 0;
+            Hide_Mouse();
+            int bw = 300, bh = 40;
+            Dialog_Box((SeenBuff.Get_Width() - bw) / 2, (SeenBuff.Get_Height() - bh) / 2, bw, bh);
+            Fancy_Text_Print("SENDING THE REPORT...",
+                             SeenBuff.Get_Width() / 2,
+                             SeenBuff.Get_Height() / 2 - 6,
+                             CC_GREEN,
+                             TBLACK,
+                             (TextPrintType)(TPF_6PT_GRAD | TPF_USE_GRAD_PAL | TPF_CENTER | TPF_NOSHADOW));
+            Show_Mouse();
+            while (!Report_Result(res, sizeof(res), &ok)) {
+                Call_Back();
+                Frame_Limiter();
+            }
+            char msg[120];
+            if (ok) {
+                std::snprintf(msg, sizeof(msg), "Report no. %s sent. Thank you!", res);
+            } else {
+                std::snprintf(msg, sizeof(msg), "Not sent: %s", res);
+            }
+            WWMessageBox().Process(msg);
+        }
+    }
+    Bug_Redraw_Map();
+    Map.Flag_To_Redraw(true);
+    busy = false;
+}
+#endif
