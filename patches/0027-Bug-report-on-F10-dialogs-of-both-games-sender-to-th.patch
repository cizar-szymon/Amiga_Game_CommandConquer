+// The picture of the front surface as an 8-bit BMP with the game's palette (bug reports).
+bool Amiga_Write_Screen_BMP(const char* path)
+{
+    if (!frontSurface) {
+        return false;
+    }
+    const unsigned char* px = frontSurface->GetFrontPixels();
+    const int w = frontSurface->GetFrontWidth();
+    const int h = frontSurface->GetFrontHeight();
+    if (!px || w <= 0 || h <= 0) {
+        return false;
+    }
+    FILE* f = std::fopen(path, "wb");
+    if (!f) {
+        return false;
+    }
+    const unsigned rowsize = ((unsigned)w + 3) & ~3u;
+    const unsigned image = rowsize * (unsigned)h;
+    const unsigned offset = 54 + 1024;
+    unsigned char hd[54];
+    std::memset(hd, 0, sizeof(hd));
+    hd[0] = 'B';
+    hd[1] = 'M';
+    const unsigned size = offset + image;
+    for (int i = 0; i < 4; i++) {
+        hd[2 + i] = (unsigned char)(size >> (8 * i));
+        hd[34 + i] = (unsigned char)(image >> (8 * i));
+    }
+    hd[10] = (unsigned char)offset;
+    hd[11] = (unsigned char)(offset >> 8);
+    hd[14] = 40;
+    hd[18] = (unsigned char)w;
+    hd[19] = (unsigned char)(w >> 8);
+    hd[22] = (unsigned char)h;
+    hd[23] = (unsigned char)(h >> 8);
+    hd[26] = 1;
+    hd[28] = 8;
+    hd[47] = 1; // 256 colours
+    std::fwrite(hd, 1, sizeof(hd), f);
+    for (int i = 0; i < 256; i++) {
+        unsigned char q[4];
+        for (int k = 0; k < 3; k++) {
+            unsigned v = RawPalette[i * 3 + (2 - k)] & 63;
+            q[k] = (unsigned char)((v << 2) | (v >> 4));
+        }
+        q[3] = 0;
+        std::fwrite(q, 1, 4, f);
+    }
+    unsigned char* row = (unsigned char*)std::calloc(1, rowsize);
+    if (row) {
+        for (int y = h - 1; y >= 0; y--) {
+            std::memcpy(row, px + (size_t)y * w, (size_t)w);
+            std::fwrite(row, 1, rowsize, f);
+        }
+        std::free(row);
+    }
+    std::fclose(f);
+    return true;
+}
+
+void Amiga_Dump_If_Requested(const unsigned char* pixels, int w, int h)
+{
+    if (DumpRequested) {
+        DumpRequested = false;
+        Dump_Frame(pixels, w, h);
+    }
+}
