                                       void const* remap,
                                       int clip_window)
 {
-    if (Lock()) {
+    bool stamp_locked;
+    {
+        PROF_SCOPE_N(prof_lock, 104);
+        stamp_locked = Lock();
+    }
+    PROF_COUNT(7);
+    if (stamp_locked) {
+        PROF_SCOPE_N(prof_clip, 105);
         Buffer_Draw_Stamp_Clip(this,
                                icondata,
                                icon,
@@ -859,7 +867,10 @@ void GraphicViewPortClass::Draw_Stamp(void const* icondata,
                                WindowList[clip_window][WINDOWWIDTH],
                                WindowList[clip_window][WINDOWHEIGHT]);
     }
-    Unlock();
+    {
+        PROF_SCOPE_N(prof_unlock, 106);
+        Unlock();
+    }
 }
 
