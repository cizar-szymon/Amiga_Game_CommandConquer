--- /dev/null
+++ b/common/moviepaula_amiga.cpp
@@ -0,0 +1,304 @@
+// Movie sound through Paula (audio.device) in a task of its own, independent of the game mixer. Used when the game
+// sound goes through AHI: with AHI (warp.audio) the movie sound froze the machine after seconds to a minute
+// (Amiga 2, 23.11.2026), Paula is a separate output on the Warp cards and both can be heard at the same time.
+// The game task appends the audio data of the movie to a byte FIFO; the task converts it to 8 bit and plays it on
+// two Paula channels (left and right get the same data for a mono movie), three buffers per channel in Chip RAM.
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include <exec/types.h>
+#include <exec/memory.h>
+#include <exec/execbase.h>
+#include <devices/audio.h>
+#include <dos/dostags.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+
+extern struct ExecBase* SysBase;
+
+#define MP_FIFO 131072
+#define MP_BUFS 3
+#define MP_FRAMES 768
+
+static unsigned char* Fifo = nullptr;
+static volatile unsigned FifoRd = 0, FifoWr = 0;
+static volatile bool Playing = false;
+static volatile bool Quit = false;
+static volatile int Ready = 0; // 1 running, -1 failed, 2 finished
+static struct Process* Proc = nullptr;
+static struct Task* ParentTask = nullptr;
+static struct Task* ProcTask = nullptr;
+static BYTE QuitSig = -1;
+static int MBits = 16;
+static bool MStereo = false;
+static unsigned MRate = 22050;
+
+static struct MsgPort* Port = nullptr;
+static struct IOAudio* Alloc = nullptr;
+static struct IOAudio* IO[MP_BUFS][2];
+static signed char* Buf[MP_BUFS][2];
+static unsigned char Busy[MP_BUFS];
+static unsigned PaulaRate = 22030;
+static unsigned Frac = 0;
+static unsigned StatSent = 0, StatPlayed = 0, StatEmpty = 0;
+static int OpenResult = 0;
+
+static void Send(int b)
+{
+    for (int c = 0; c < 2; ++c) {
+        IO[b][c]->ioa_Request.io_Command = CMD_WRITE;
+        IO[b][c]->ioa_Request.io_Flags = ADIOF_PERVOL;
+        IO[b][c]->ioa_Length = MP_FRAMES;
+        SendIO((struct IORequest*)IO[b][c]);
+    }
+    Busy[b] = 2;
+    ++StatSent;
+}
+
+// Fill one buffer pair from the FIFO (silence when nothing is playing or the FIFO is empty).
+static void Fill_And_Send(int b)
+{
+    const unsigned fb = (unsigned)((MBits / 8) * (MStereo ? 2 : 1));
+    const unsigned mask = MP_FIFO - 1;
+    const unsigned step = (unsigned)(((unsigned long)MRate << 16) / PaulaRate);
+    unsigned rd = FifoRd;
+    unsigned avail = (FifoWr - rd) / fb;
+    unsigned frac = Frac;
+    bool play = Playing;
+    for (int i = 0; i < MP_FRAMES; ++i) {
+        signed char l = 0, r = 0;
+        unsigned idx = frac >> 16;
+        if (play && idx < avail) {
+            unsigned o = (rd + idx * fb) & mask;
+            if (MBits == 8) {
+                l = (signed char)((int)Fifo[o] - 128);
+                r = MStereo ? (signed char)((int)Fifo[(o + 1) & mask] - 128) : l;
+            } else {
+                l = (signed char)Fifo[o]; // big endian 16 bit: the first byte is the high byte
+                r = MStereo ? (signed char)Fifo[(o + 2) & mask] : l;
+            }
+            frac += step;
+        }
+        Buf[b][0][i] = l;
+        Buf[b][1][i] = r;
+    }
+    if (play && avail == 0) {
+        ++StatEmpty;
+    }
+    if (play) {
+        unsigned used = frac >> 16;
+        if (used > avail) {
+            used = avail;
+        }
+        StatPlayed += used * fb;
+        FifoRd = rd + used * fb;
+        Frac = frac & 0xFFFF;
+    }
+    Send(b);
+}
+
+static void Task_Main()
+{
+    static UBYTE channels[] = {3, 5, 10, 12};
+    const ULONG clock = (SysBase->VBlankFrequency == 50) ? 3546895UL : 3579545UL;
+    bool ok = false;
+
+    QuitSig = AllocSignal(-1);
+    Port = CreateMsgPort();
+    if (Port && QuitSig >= 0) {
+        Alloc = (struct IOAudio*)CreateIORequest(Port, sizeof(struct IOAudio));
+    }
+    if (Alloc) {
+        Alloc->ioa_Request.io_Message.mn_Node.ln_Pri = 1;
+        Alloc->ioa_Request.io_Flags = ADIOF_NOWAIT;
+        Alloc->ioa_Data = channels;
+        Alloc->ioa_Length = sizeof(channels);
+        if (OpenDevice((CONST_STRPTR)AUDIONAME, 0, (struct IORequest*)Alloc, 0) == 0) {
+            ok = true;
+        } else {
+            DeleteIORequest((struct IORequest*)Alloc);
+            Alloc = nullptr;
+        }
+    }
+    const UWORD period = (UWORD)((clock + 22050 - 1) / 22050);
+    PaulaRate = clock / period;
+    if (ok) {
+        ULONG units = (ULONG)Alloc->ioa_Request.io_Unit;
+        for (int b = 0; b < MP_BUFS && ok; ++b) {
+            for (int c = 0; c < 2; ++c) {
+                Buf[b][c] = (signed char*)AllocMem(MP_FRAMES, MEMF_CHIP | MEMF_CLEAR);
+                struct IOAudio* io = (struct IOAudio*)AllocMem(sizeof(struct IOAudio), MEMF_PUBLIC);
+                if (!Buf[b][c] || !io) {
+                    ok = false;
+                    break;
+                }
+                *io = *Alloc;
+                io->ioa_Request.io_Unit = (struct Unit*)(units & (c ? 0x06 : 0x09));
+                io->ioa_Data = (UBYTE*)Buf[b][c];
+                io->ioa_Period = period;
+                io->ioa_Volume = 64;
+                io->ioa_Cycles = 1;
+                IO[b][c] = io;
+            }
+        }
+    }
+    if (ok) {
+        for (int b = 0; b < MP_BUFS; ++b) {
+            Fill_And_Send(b);
+        }
+    }
+    Ready = ok ? 1 : -1;
+    Signal(ParentTask, SIGF_SINGLE);
+
+    while (ok && !Quit) {
+        ULONG sigs = Wait((1UL << Port->mp_SigBit) | (1UL << QuitSig));
+        if (sigs & (1UL << QuitSig)) {
+            break;
+        }
+        struct IOAudio* io;
+        while ((io = (struct IOAudio*)GetMsg(Port)) != nullptr) {
+            for (int b = 0; b < MP_BUFS; ++b) {
+                for (int c = 0; c < 2; ++c) {
+                    if (IO[b][c] == io && Busy[b]) {
+                        --Busy[b];
+                    }
+                }
+            }
+        }
+        for (int b = 0; b < MP_BUFS; ++b) {
+            if (!Busy[b]) {
+                Fill_And_Send(b);
+            }
+        }
+    }
+
+    for (int b = 0; b < MP_BUFS; ++b) {
+        for (int c = 0; c < 2; ++c) {
+            if (IO[b][c]) {
+                if (Busy[b]) {
+                    AbortIO((struct IORequest*)IO[b][c]);
+                    WaitIO((struct IORequest*)IO[b][c]);
+                }
+                FreeMem(IO[b][c], sizeof(struct IOAudio));
+                IO[b][c] = nullptr;
+            }
+            if (Buf[b][c]) {
+                FreeMem(Buf[b][c], MP_FRAMES);
+                Buf[b][c] = nullptr;
+            }
+        }
+        Busy[b] = 0;
+    }
+    if (Alloc) {
+        CloseDevice((struct IORequest*)Alloc);
+        DeleteIORequest((struct IORequest*)Alloc);
+        Alloc = nullptr;
+    }
+    if (Port) {
+        DeleteMsgPort(Port);
+        Port = nullptr;
+    }
+    if (QuitSig >= 0) {
+        FreeSignal(QuitSig);
+        QuitSig = -1;
+    }
+    ProcTask = nullptr;
+    Ready = 2;
+}
+
+void MoviePaula_Close();
+
+bool MoviePaula_Open(int bits_per_sample, bool stereo, int rate)
+{
+    if (Proc) {
+        return false;
+    }
+    Fifo = (unsigned char*)std::malloc(MP_FIFO);
+    if (!Fifo) {
+        return false;
+    }
+    FifoRd = FifoWr = 0;
+    Frac = 0;
+    Playing = false;
+    Quit = false;
+    Ready = 0;
+    MBits = bits_per_sample;
+    MStereo = stereo;
+    MRate = (unsigned)rate;
+    static bool exit_hook = false;
+    if (!exit_hook) {
+        exit_hook = true;
+        std::atexit(MoviePaula_Close); // exit() and Ctrl-C bypass the normal shutdown: the task must not outlive the program
+    }
+    ParentTask = FindTask(nullptr);
+    SetSignal(0, SIGF_SINGLE);
+    StatSent = StatPlayed = StatEmpty = 0;
+    OpenResult = 0;
+    Proc = CreateNewProcTags(NP_Entry, (ULONG)Task_Main, NP_Name, (ULONG) "cnc-movie-audio", NP_Priority, 10UL, NP_StackSize, 16384UL, TAG_DONE);
+    if (!Proc) {
+        std::free(Fifo);
+        Fifo = nullptr;
+        return false;
+    }
+    ProcTask = &Proc->pr_Task;
+    Wait(SIGF_SINGLE);
+    OpenResult = Ready;
+    if (Ready != 1) {
+        for (int i = 0; i < 300 && Ready != 2; ++i) {
+            Delay(1);
+        }
+        Delay(5);
+        Proc = nullptr;
+        std::free(Fifo);
+        Fifo = nullptr;
+        return false;
+    }
+    return true;
+}
+
+unsigned MoviePaula_Space()
+{
+    return MP_FIFO - (FifoWr - FifoRd);
+}
+
+void MoviePaula_Write(const void* data, unsigned len)
+{
+    const unsigned char* d = (const unsigned char*)data;
+    unsigned wr = FifoWr;
+    for (unsigned i = 0; i < len; ++i) {
+        Fifo[(wr + i) & (MP_FIFO - 1)] = d[i];
+    }
+    FifoWr = wr + len;
+}
+
+void MoviePaula_Play(bool play)
+{
+    Playing = play;
+}
+
+void MoviePaula_Close()
+{
+    if (!Proc) {
+        return;
+    }
+    Playing = false;
+    Quit = true;
+    if (ProcTask && QuitSig >= 0) {
+        Signal(ProcTask, 1UL << QuitSig);
+    }
+    for (int i = 0; i < 300 && Ready != 2; ++i) {
+        Delay(1);
+    }
+    Delay(5); // the task is still returning from its entry function
+    {
+        FILE* f = std::fopen("RAM:cnc-sound-log.txt", "a");
+        if (f) {
+            std::fprintf(f, "movie paula: open %d, written %u bytes, played %u bytes, %u buffers sent, %u empty, rate %u bits %d stereo %d, paula rate %u\n", OpenResult, FifoWr, StatPlayed, StatSent, StatEmpty, MRate, MBits, (int)MStereo, PaulaRate);
+            std::fclose(f);
+        }
+    }
+    Proc = nullptr;
+    std::free(Fifo);
+    Fifo = nullptr;
+}
