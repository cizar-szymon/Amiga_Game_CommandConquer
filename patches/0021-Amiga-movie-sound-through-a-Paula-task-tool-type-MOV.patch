 VQAHandle* AudioVQAHandle;
 
 static TimerClass timer;
-static SampleTrackerTypeImp* Stream = nullptr;
+static SampleTrackerTypeImp* Stream = nullptr; // stream tracker of the game mixer (game sound through Paula)
+static bool ViaPaulaTask = false;              // or the Paula task of its own (game sound through AHI)
+static bool Opened = false;
 
-// Create the stream tracker once the sound format of the movie is known; false = silent movie.
+static unsigned S_Space()
+{
+    return ViaPaulaTask ? MoviePaula_Space() : Amiga_Stream_Space(Stream);
+}
+
+static void S_Write(const void* d, unsigned n)
+{
+    if (ViaPaulaTask) {
+        MoviePaula_Write(d, n);
+    } else {
+        Amiga_Stream_Write(Stream, d, n);
+    }
+}
+
+static void S_Play(bool on)
+{
+    if (ViaPaulaTask) {
+        MoviePaula_Play(on);
+    } else {
+        Amiga_Stream_Play(Stream, on);
+    }
+}
+
+// Create the sound output once the sound format of the movie is known; without it the movie is silent.
+// Game sound through Paula: a stream tracker in the mixer. Through AHI: see below.
 static void Open_Stream(VQAAudio* audio)
 {
-    if (Stream || !Amiga_Sound_Active()) {
+    if (Opened || !Amiga_Sound_Active()) {
         return;
     }
-    // Movie sound is played through Paula only. With AHI (warp.audio on the Warp cards) the machine froze after a few
-    // seconds to a minute of movie sound (Amiga 2, 23.11.2026; the same movie without sound runs for hours), cause not
-    // found: with AHI the movies are silent, unless the file PROGDIR:vqaahi exists (for tests).
-    if (Amiga_Sound_Backend() == 2) {
-        FILE* f = fopen("PROGDIR:vqaahi", "r");
-        if (!f) {
-            return;
-        }
-        fclose(f);
-    }
     if (audio->SampleRate <= 0 || (audio->BitsPerSample != 8 && audio->BitsPerSample != 16)) {
         return;
     }
-    Stream = Amiga_Stream_Open(audio->BitsPerSample, audio->Channels > 1, audio->SampleRate);
+    int backend = Amiga_Sound_Backend();
+    if (backend == 1) {
+        Stream = Amiga_Stream_Open(audio->BitsPerSample, audio->Channels > 1, audio->SampleRate);
+        Opened = Stream != nullptr;
+        ViaPaulaTask = false;
+    } else if (backend == 2) {
+        // Game sound through AHI: the movies are silent by default. Movie sound mixed into AHI froze Amiga 2 (see
+        // docs/PORTING.md); through a Paula task of its own it plays but was not audible on Amiga 2 (Paula output not
+        // connected there). Tool type MOVIESOUND=PAULA (or MOVIESOUND=AHI, for tests) switches it on.
+        extern const char* Amiga_ToolType(const char*);
+        const char* t = Amiga_ToolType("MOVIESOUND");
+        if (t && (t[0] == 'P' || t[0] == 'p')) {
+            Opened = MoviePaula_Open(audio->BitsPerSample, audio->Channels > 1, audio->SampleRate);
+            ViaPaulaTask = Opened;
+        } else if (t && (t[0] == 'A' || t[0] == 'a')) {
+            Stream = Amiga_Stream_Open(audio->BitsPerSample, audio->Channels > 1, audio->SampleRate);
+            Opened = Stream != nullptr;
+            ViaPaulaTask = false;
+        }
+    }
 }
 
