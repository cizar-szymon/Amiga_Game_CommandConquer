+// The movie clock is the timer, as in the original. With sound it is shifted by the sound output delay (the sound is
+// heard a little after it left the mixer): MovieLag frames, negative values let the picture run ahead.
 unsigned VQA_GetTime(VQAHandle* handle)
 {
-    return timer.Time();
+    const unsigned t = timer.Time();
+    if (Opened && (AudioFlags & VQA_AUDIO_FLAG_AUDIO_DMA_TIMER)) {
+        if (!ViaPaulaTask && Stream) {
+            // tell the mixer where the sound should be now (it corrects its speed, see Mix_Fifo)
+            if (!ClkStarted) {
+                ClkStarted = true;
+                ClkT0 = t;
+            }
+            Amiga_Stream_Expect(Stream, (int)((t - ClkT0) * MovieRate / 60u) - MovieLag);
+        }
+        if (MovieLag >= 0) {
+            const unsigned lag = (unsigned)MovieLag * 60u / MovieRate;
+            return t > lag ? t - lag : 0;
+        }
+        return t + (unsigned)(-MovieLag) * 60u / MovieRate;
+    }
+    return t;
 }
 
 int VQA_TimerMethod()
