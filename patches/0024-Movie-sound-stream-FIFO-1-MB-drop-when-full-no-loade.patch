@@ -145,25 +148,54 @@ static void Mix_Segment(int* acc, const QBuf& b, unsigned& frac, unsigned step,
 static void Mix_Fifo(int* acc, SampleTrackerTypeImp& t, int frames)
 {
     const unsigned fb = (unsigned)((t.Bits / 8) * (t.Stereo ? 2 : 1));
-    const unsigned step = (unsigned)(((unsigned long)t.Rate << 16) / OUT_RATE);
+    unsigned step = (unsigned)(((unsigned long)t.Rate << 16) / OUT_RATE);
     const unsigned mask = t.FifoSize - 1;
     unsigned rd = t.FifoRd;
     unsigned avail = (t.FifoWr - rd) / fb; // whole frames
+    // The movie clock is the timer. The sound output runs a little slower or faster than the timer, so the picture and
+    // the sound would drift apart in a long movie. The game task tells how many frames should have been played by now
+    // (Expected); the stream is played up to 8 % faster or slower to make up the difference (interpolated, no crackle).
+    // After running dry it waits until a little data has collected instead of stuttering with every chunk.
+    if (t.Starved) {
+        if (avail < (unsigned)(t.Rate / 10)) {
+            return; // silence, nothing consumed
+        }
+        t.Starved = false;
+    }
+    {
+        const long diff = (long)t.Expected - (long)t.Consumed; // > 0: the sound is late
+        long adj = diff * (long)step / (long)(t.Rate * 2);     // makes up the difference in about 2 s
+        const long lim = (long)step / 12;
+        if (adj > lim)
+            adj = lim;
+        else if (adj < -lim)
+            adj = -lim;
+        step = (unsigned)((long)step + adj);
+    }
     unsigned frac = t.Frac;
     for (int i = 0; i < frames; ++i) {
         unsigned idx = frac >> 16;
-        if (idx + 1 > avail) {
-            break; // underrun
+        if (idx + 2 > avail) {
+            t.Starved = true;
+            break; // underrun (one more frame is needed for the interpolation)
         }
-        unsigned o = (rd + idx * fb) & mask;
-        int l, r;
+        const unsigned o0 = (rd + idx * fb) & mask;
+        const unsigned o1 = (rd + (idx + 1) * fb) & mask;
+        const int w = (int)((frac >> 8) & 0xFF); // weight of the next frame, 0..255
+        int l0, r0, l1, r1;
         if (t.Bits == 8) {
-            l = ((int)t.Fifo[o] - 128) << 8;
-            r = t.Stereo ? ((int)t.Fifo[(o + 1) & mask] - 128) << 8 : l;
+            l0 = ((int)t.Fifo[o0] - 128) << 8;
+            r0 = t.Stereo ? ((int)t.Fifo[(o0 + 1) & mask] - 128) << 8 : l0;
+            l1 = ((int)t.Fifo[o1] - 128) << 8;
+            r1 = t.Stereo ? ((int)t.Fifo[(o1 + 1) & mask] - 128) << 8 : l1;
         } else {
-            l = (short)((t.Fifo[o] << 8) | t.Fifo[(o + 1) & mask]); // big endian samples
-            r = t.Stereo ? (short)((t.Fifo[(o + 2) & mask] << 8) | t.Fifo[(o + 3) & mask]) : l;
+            l0 = (short)((t.Fifo[o0] << 8) | t.Fifo[(o0 + 1) & mask]); // big endian samples
+            r0 = t.Stereo ? (short)((t.Fifo[(o0 + 2) & mask] << 8) | t.Fifo[(o0 + 3) & mask]) : l0;
+            l1 = (short)((t.Fifo[o1] << 8) | t.Fifo[(o1 + 1) & mask]);
+            r1 = t.Stereo ? (short)((t.Fifo[(o1 + 2) & mask] << 8) | t.Fifo[(o1 + 3) & mask]) : l1;
         }
+        const int l = l0 + (((l1 - l0) * w) >> 8);
+        const int r = r0 + (((r1 - r0) * w) >> 8);
         acc[2 * i] += (int)(((long)l * (long)t.Volume) >> 16);
         acc[2 * i + 1] += (int)(((long)r * (long)t.Volume) >> 16);
         frac += step;
@@ -173,6 +205,7 @@ static void Mix_Fifo(int* acc, SampleTrackerTypeImp& t, int frames)
         used = avail;
     }
     t.FifoRd = rd + used * fb;
+    t.Consumed += (int)used;
     t.Frac = frac & 0xFFFF;
 }
 
