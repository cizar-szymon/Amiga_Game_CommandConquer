diff --git a/common/paulahw_amiga.cpp b/common/paulahw_amiga.cpp
new file mode 100644
index 0000000..9f61dbe
--- /dev/null
+++ b/common/paulahw_amiga.cpp
@@ -0,0 +1,190 @@
+// Paula output with direct access to the audio hardware, shared by the game mixer (soundio_amiga.cpp) and the movie
+// sound task (moviepaula_amiga.cpp). audio.device plays nothing audible on Amiga 2 (A4000 + Warp 7060, 23.11.2026) while
+// the hardware itself is fine (HippoPlayer), so the channels are only locked through audio.device (priority 127, as
+// players do) and then driven directly: one left and one right channel, two 8 bit buffers per channel in Chip RAM that
+// Paula plays in turn. The end of a buffer sets the audio interrupt flag in INTREQR (read by polling, the interrupt
+// itself stays off): then the next buffer is already playing, the one that has just finished is refilled and its
+// address written to AUDxLC, from where Paula takes it at the end of the buffer now playing.
+#include <exec/types.h>
+#include <exec/memory.h>
+#include <exec/execbase.h>
+#include <devices/audio.h>
+#include <devices/timer.h>
+#include <proto/exec.h>
+
+extern struct ExecBase* SysBase;
+
+static struct MsgPort* AudPort = nullptr;
+static struct IOAudio* AudIO = nullptr;
+static struct MsgPort* TimPort = nullptr;
+static struct timerequest* TimReq = nullptr;
+static bool TimOpen = false;
+static signed char* Buf[2][2]; // [side][index]
+static unsigned Frames = 0;
+static int LCh = 0, RCh = 1;
+static UWORD Period = 0;
+static unsigned Events = 0;
+static bool Running = false;
+
+#define CUSTOM ((volatile UWORD*)0xDFF000)
+#define CH_LC(ch) ((volatile ULONG*)(0xDFF0A0 + (ch)*0x10))
+#define CH_LEN(ch) (CUSTOM[(0xA4 + (ch)*0x10) / 2])
+#define CH_PER(ch) (CUSTOM[(0xA6 + (ch)*0x10) / 2])
+#define CH_VOL(ch) (CUSTOM[(0xA8 + (ch)*0x10) / 2])
+
+void PaulaHw_Close();
+
+// frames: bytes per buffer (even), period: Paula period for the output rate. False when the channels are busy.
+bool PaulaHw_Open(unsigned frames, unsigned period)
+{
+    static UBYTE channels[] = {3, 5, 10, 12};
+    Frames = frames;
+    Period = (UWORD)period;
+    Events = 0;
+    Running = false;
+    for (int s = 0; s < 2; ++s)
+        for (int i = 0; i < 2; ++i)
+            Buf[s][i] = nullptr;
+
+    AudPort = CreateMsgPort();
+    if (!AudPort) {
+        return false;
+    }
+    AudIO = (struct IOAudio*)CreateIORequest(AudPort, sizeof(struct IOAudio));
+    if (!AudIO) {
+        PaulaHw_Close();
+        return false;
+    }
+    AudIO->ioa_Request.io_Message.mn_Node.ln_Pri = 127; // nobody takes the channels away
+    AudIO->ioa_Request.io_Flags = ADIOF_NOWAIT;
+    AudIO->ioa_Data = channels;
+    AudIO->ioa_Length = sizeof(channels);
+    if (OpenDevice((CONST_STRPTR)AUDIONAME, 0, (struct IORequest*)AudIO, 0)) {
+        DeleteIORequest((struct IORequest*)AudIO);
+        AudIO = nullptr;
+        PaulaHw_Close();
+        return false;
+    }
+    ULONG units = (ULONG)AudIO->ioa_Request.io_Unit;
+    LCh = (units & 1) ? 0 : 3;
+    RCh = (units & 2) ? 1 : 2;
+    for (int s = 0; s < 2; ++s) {
+        for (int i = 0; i < 2; ++i) {
+            Buf[s][i] = (signed char*)AllocMem(frames, MEMF_CHIP | MEMF_CLEAR);
+            if (!Buf[s][i]) {
+                PaulaHw_Close();
+                return false;
+            }
+        }
+    }
+    TimPort = CreateMsgPort();
+    TimReq = TimPort ? (struct timerequest*)CreateIORequest(TimPort, sizeof(struct timerequest)) : nullptr;
+    if (!TimReq || OpenDevice((CONST_STRPTR)TIMERNAME, UNIT_MICROHZ, (struct IORequest*)TimReq, 0)) {
+        PaulaHw_Close();
+        return false;
+    }
+    TimOpen = true;
+    return true;
+}
+
+signed char* PaulaHw_Buf(int side, int idx)
+{
+    return Buf[side][idx];
+}
+
+// Both sides of buffer 0 must be filled; buffer 1 is filled at the first event.
+void PaulaHw_Start()
+{
+    CacheClearE(Buf[0][0], Frames, CACRF_ClearD);
+    CacheClearE(Buf[1][0], Frames, CACRF_ClearD);
+    const UWORD bits = (UWORD)((1 << LCh) | (1 << RCh));
+    const UWORD ints = (UWORD)((1 << (7 + LCh)) | (1 << (7 + RCh)));
+    Forbid();
+    CUSTOM[0x96 / 2] = bits; // DMA off
+    CUSTOM[0x9C / 2] = ints; // clear the interrupt flags
+    *CH_LC(LCh) = (ULONG)Buf[0][0];
+    CH_LEN(LCh) = (UWORD)(Frames / 2);
+    CH_PER(LCh) = Period;
+    CH_VOL(LCh) = 64;
+    *CH_LC(RCh) = (ULONG)Buf[1][0];
+    CH_LEN(RCh) = (UWORD)(Frames / 2);
+    CH_PER(RCh) = Period;
+    CH_VOL(RCh) = 64;
+    CUSTOM[0x96 / 2] = (UWORD)(0x8200 | bits); // both channels start together
+    Permit();
+    Events = 0;
+    Running = true;
+}
+
+// Index of the buffer to fill next (then PaulaHw_Commit), or -1 when no buffer has finished since the last call.
+int PaulaHw_Poll()
+{
+    const UWORD ints = (UWORD)((1 << (7 + LCh)) | (1 << (7 + RCh)));
+    if (!Running || !(CUSTOM[0x1E / 2] & (1 << (7 + LCh)))) {
+        return -1;
+    }
+    CUSTOM[0x9C / 2] = ints;
+    unsigned n = Events++; // event 0 is the start of the DMA: buffer 0 plays, buffer 1 is to be filled
+    return (int)((n + 1) & 1); // event n: buffer n&1 plays, the other one is queued next
+}
+
+void PaulaHw_Commit(int idx)
+{
+    CacheClearE(Buf[0][idx], Frames, CACRF_ClearD);
+    CacheClearE(Buf[1][idx], Frames, CACRF_ClearD);
+    *CH_LC(LCh) = (ULONG)Buf[0][idx];
+    *CH_LC(RCh) = (ULONG)Buf[1][idx];
+}
+
+// Sleeps about 4 ms or until one of the signals in 'sigs' arrives; returns the signals of 'sigs' that came.
+ULONG PaulaHw_Wait(ULONG sigs)
+{
+    TimReq->tr_node.io_Command = TR_ADDREQUEST;
+    TimReq->tr_time.tv_secs = 0;
+    TimReq->tr_time.tv_micro = 4000;
+    SendIO((struct IORequest*)TimReq);
+    ULONG got = Wait(sigs | (1UL << TimPort->mp_SigBit));
+    AbortIO((struct IORequest*)TimReq);
+    WaitIO((struct IORequest*)TimReq);
+    return got & sigs;
+}
+
+void PaulaHw_Close()
+{
+    if (Running) {
+        const UWORD bits = (UWORD)((1 << LCh) | (1 << RCh));
+        CUSTOM[0x96 / 2] = bits;
+        CH_VOL(LCh) = 0;
+        CH_VOL(RCh) = 0;
+        Running = false;
+    }
+    for (int s = 0; s < 2; ++s) {
+        for (int i = 0; i < 2; ++i) {
+            if (Buf[s][i]) {
+                FreeMem(Buf[s][i], Frames);
+                Buf[s][i] = nullptr;
+            }
+        }
+    }
+    if (TimOpen) {
+        CloseDevice((struct IORequest*)TimReq);
+        TimOpen = false;
+    }
+    if (TimReq) {
+        DeleteIORequest((struct IORequest*)TimReq);
+        TimReq = nullptr;
+    }
+    if (TimPort) {
+        DeleteMsgPort(TimPort);
+        TimPort = nullptr;
+    }
+    if (AudIO) {
+        CloseDevice((struct IORequest*)AudIO);
+        DeleteIORequest((struct IORequest*)AudIO);
+        AudIO = nullptr;
+    }
+    if (AudPort) {
+        DeleteMsgPort(AudPort);
+        AudPort = nullptr;
+    }
+}
