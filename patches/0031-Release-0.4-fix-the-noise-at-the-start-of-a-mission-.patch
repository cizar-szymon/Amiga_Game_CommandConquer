+#endif
 int File_Stream_Sample_Vol(char const* filename, int volume, bool real_time_start)
 {
     if (LockedData.DigiHandle == INVALID_AUDIO_HANDLE || filename == nullptr || !Find_File(filename)) {
@@ -535,6 +542,9 @@ int File_Stream_Sample_Vol(char const* filename, int volume, bool real_time_star
     }
 
     int handle = Get_Free_Sample_Handle(PRIORITY_MAX);
+#ifdef __amigaos__
+    Amiga_Sound_Note("music track started, tracker", handle);
+#endif
 
     if (handle < MAX_SAMPLE_TRACKERS) {
         SampleTrackerType* st = &LockedData.SampleTracker[handle];
@@ -833,6 +843,9 @@ void Stop_Sample(int index)
             }
 
             st->QueueBuffer = nullptr;
+            st->FilePending = 0;
+            st->FilePendingSize = 0;
+            st->Callback = nullptr;
         }
     }
 }
@@ -1011,6 +1024,16 @@ static int Play_Sample_Handle(const void* sample, int priority, int volume, sign
 
         SampleTrackerType* st = &LockedData.SampleTracker[id];
 
+        if (!StreamingStart) {
+            // A tracker that played a music stream and was stopped before the end still counted buffers read ahead
+            // (FilePending) and had its callback. Left there, the buffers of the old music were appended to the next
+            // sound of this tracker once its own data had run out and were played as if they were samples: loud noise
+            // for as long as they lasted (RA and TD, found on 24.11.2026).
+            st->FilePending = 0;
+            st->FilePendingSize = 0;
+            st->Callback = nullptr;
+        }
+
         // Read in the sample's header.
         AUDHeaderType raw_header;
         memcpy(&raw_header, sample, sizeof(raw_header));
