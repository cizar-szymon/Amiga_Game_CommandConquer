diff --git a/common/bugtextbox.h b/common/bugtextbox.h
new file mode 100644
index 0000000..90f1ad5
--- /dev/null
+++ b/common/bugtextbox.h
@@ -0,0 +1,148 @@
+// A text box of several lines for the bug report dialog (Amiga): the text is one string, long text goes to the next
+// line by itself (at a space when it can, in the middle of a word when a word is longer than the line). Made on the
+// game's own EditClass, so it looks like it and takes the keyboard the same way. Return is not a line break: it ends
+// the input like in every edit box of the game (the dialog sends the report then).
+// Include after the game's function.h and define BUGBOX_SET_FONT(flags) first: it sets the font of the box (the call
+// of Fancy_Text_Print with no text; its arguments differ between the two games).
+#ifndef BUGTEXTBOX_H
+#define BUGTEXTBOX_H
+
+#include "edit.h"
+
+#ifndef BUGBOX_SET_FONT
+#error "define BUGBOX_SET_FONT(flags) before including bugtextbox.h"
+#endif
+#include <cctype>
+#include <cstring>
+
+class BugTextBox : public EditClass
+{
+public:
+    BugTextBox(int id, char* text, int max_len, TextPrintType flags, int x, int y, int w, int h)
+        : EditClass(id, text, max_len, flags, x, y, w, h, EditClass::ALPHANUMERIC)
+    {
+    }
+
+protected:
+    enum
+    {
+        MAX_LINES = 40
+    };
+
+    // The font of the box (the width of the text is measured with the font that was used last).
+    void Use_Font()
+    {
+        BUGBOX_SET_FONT(TextFlags);
+    }
+
+    int Line_Height() const
+    {
+        return FontHeight + 1;
+    }
+
+    int Max_Lines() const
+    {
+        int n = (Height - 2) / Line_Height();
+        return n < 1 ? 1 : (n > MAX_LINES - 1 ? MAX_LINES - 1 : n);
+    }
+
+    // The text cut into lines that fit the width of the box: start and length of each; returns the number of lines.
+    int Wrap(const char* s, int* start, int* length) const
+    {
+        const int maxw = Width - 4;
+        int total = (int)std::strlen(s);
+        int n = 0;
+        int i = 0;
+        while (i < total && n < MAX_LINES) {
+            char buf[160];
+            int j = i;
+            int k = 0;
+            int last_space = -1;
+            while (j < total && k < (int)sizeof(buf) - 2) {
+                buf[k] = s[j];
+                buf[k + 1] = 0;
+                if ((int)String_Pixel_Width(buf) > maxw) {
+                    break;
+                }
+                if (s[j] == ' ') {
+                    last_space = j;
+                }
+                j++;
+                k++;
+            }
+            int end = j;
+            if (j < total && last_space > i) {
+                end = last_space + 1; // the word that does not fit goes to the next line
+            }
+            if (end <= i) {
+                end = i + 1;
+            }
+            start[n] = i;
+            length[n] = end - i;
+            n++;
+            i = end;
+        }
+        return n;
+    }
+
+    virtual void Draw_Text(char const* text)
+    {
+        Use_Font();
+        TextPrintType flags = Has_Focus() ? TPF_BRIGHT_COLOR : (TextPrintType)0;
+        int start[MAX_LINES], length[MAX_LINES];
+        int n = Wrap(text, start, length);
+        int lh = Line_Height();
+        for (int i = 0; i < n; i++) {
+            char line[160];
+            int len = length[i] < (int)sizeof(line) - 1 ? length[i] : (int)sizeof(line) - 1;
+            std::memcpy(line, text + start[i], len);
+            line[len] = 0;
+            Conquer_Clip_Text_Print(line, X + 1, Y + 1 + i * lh, Color, TBLACK, TextFlags | flags, Width - 2);
+        }
+        if (Has_Focus() && Length < MaxLength) {
+            // the cursor: after the last line, or at the start of the next one when that line is full
+            int row = n > 0 ? n - 1 : 0;
+            int cx = 0;
+            if (n > 0) {
+                char line[160];
+                int len = length[row] < (int)sizeof(line) - 1 ? length[row] : (int)sizeof(line) - 1;
+                std::memcpy(line, text + start[row], len);
+                line[len] = 0;
+                cx = (int)String_Pixel_Width(line);
+            }
+            if (cx + (int)String_Pixel_Width("_") >= Width - 3) {
+                row++;
+                cx = 0;
+            }
+            if ((row + 1) * lh <= Height) {
+                Conquer_Clip_Text_Print("_", X + 1 + cx, Y + 1 + row * lh, Color, TBLACK, TextFlags | flags);
+            }
+        }
+    }
+
+    virtual bool Handle_Key(KeyASCIIType ascii)
+    {
+        if (ascii == 0 || ascii == KA_RETURN || ascii == KA_BACKSPACE) {
+            return EditClass::Handle_Key(ascii);
+        }
+        if (Length >= MaxLength || (!isgraph(ascii) && ascii != ' ')) {
+            return true;
+        }
+        if (ascii == ' ' && (Length == 0 || String[Length - 1] == ' ')) {
+            return true; // no space at the start and no two spaces in a row
+        }
+        Use_Font();
+        String[Length] = (char)ascii;
+        String[Length + 1] = '\0';
+        int start[MAX_LINES], length[MAX_LINES];
+        if (Wrap(String, start, length) > Max_Lines()) {
+            String[Length] = '\0'; // the box is full
+            return true;
+        }
+        Length++;
+        Flag_To_Redraw();
+        return true;
+    }
+};
+
+#endif
