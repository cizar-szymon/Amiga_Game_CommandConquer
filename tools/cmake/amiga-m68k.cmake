# CMake toolchain: bebbo m68k-amigaos gcc 6.5.0b (libnix), 68060 + FPU.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR m68k)
set(CMAKE_C_COMPILER   m68k-amigaos-gcc)
set(CMAKE_CXX_COMPILER m68k-amigaos-g++)
set(CMAKE_AR           m68k-amigaos-ar CACHE FILEPATH "")
set(CMAKE_RANLIB       m68k-amigaos-ranlib CACHE FILEPATH "")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(AMIGA_FLAGS "-mcpu=68060 -mhard-float -noixemul -O2 -fomit-frame-pointer -fno-strict-aliasing -fno-tree-loop-distribute-patterns")
if(DEFINED ENV{CNC_PROFILE})
    set(AMIGA_FLAGS "${AMIGA_FLAGS} -DCNC_PROFILE")
endif()
set(CMAKE_C_FLAGS_INIT   "${AMIGA_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${AMIGA_FLAGS} -std=gnu++11")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-noixemul")
set(AMIGA TRUE)

# gcc 6.5 (bebbo) miscompiles the LCW decoder at -O3 (overlapping copies give wrong pixels), so Release is built with -O2
set(CMAKE_C_FLAGS_RELEASE "-O2 -DNDEBUG -g")
set(CMAKE_CXX_FLAGS_RELEASE "-O2 -DNDEBUG -g")
